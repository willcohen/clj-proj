# .clj-kondo/config.edn is a tracked project source. The hooks themselves
# live in resources/clj-kondo.exports/net.willcohen/proj, because cg consumes
# clj-proj as a library and needs them to resolve the generated PROJ surface.
.clj-kondo/.cache
# Copied in from dependencies by `clj-kondo --copy-configs`. Refresh with:
#   clj-kondo --lint "$(clojure -Spath)" --copy-configs --skip-lint
# net.willcohen/native carries hooks.native.generated, which .clj-kondo/
# config.edn names in :config-paths, so that step is necessary after a clone.
.clj-kondo/babashka
.clj-kondo/cnuernber
.clj-kondo/http-kit
.clj-kondo/imports
.clj-kondo/net.willcohen
