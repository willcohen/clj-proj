  test:jar {:doc "Run the downstream-dependency tests against the built JAR."
            :depends [jar]
            :task (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))
                        jar-path (str "target/proj-" version ".jar")
                        run-from-jar!
                        (fn [label extra-flags form]
                          (let [result (apply clojure.java.shell/sh
                                              clj-cmd "-J--enable-native-access=ALL-UNNAMED"
                                              (concat extra-flags
                                                      ["-Sdeps" (pr-str {:deps {'net.willcohen/proj {:local/root jar-path}}})
                                                       "-M" "-e" (pr-str form)]))]
                            (when (not= 0 (:exit result))
                              (println (str label " failed!"))
                              (print (:out result))
                              (print (:err result))
                              (System/exit 1))))]
                    (println "Testing JAR as downstream dependency...")
                    (println)

                    (println "1. Testing FFI mode from JAR...")
                    (run-from-jar!
                     "FFI test" []
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/force-ffi!)
                        (proj/init!)
                        (assert (proj/ffi?) "Should be in FFI mode")
                        (let [ctx (proj/context-create)]
                          (assert ctx "Context creation failed")
                          (let [t (proj/proj-create-crs-to-crs
                                   {:context ctx
                                    :source_crs "EPSG:4326"
                                    :target_crs "EPSG:3857"})]
                            (assert t "Transformer creation failed")))
                        (println "   OK FFI mode test passed")))

                    (println)
                    (println "2. Testing GraalVM/WASM mode from JAR...")
                    (run-from-jar!
                     "GraalVM test" ["-J-Dpolyglot.engine.WarnInterpreterOnly=false"]
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/force-graal!)
                        (proj/init!)
                        (assert (proj/graal?) "Should be in GraalVM mode")
                        (let [ctx (proj/context-create)]
                          (assert ctx "Context creation failed")
                          (let [t (proj/proj-create-crs-to-crs
                                   {:context ctx
                                    :source_crs "EPSG:4326"
                                    :target_crs "EPSG:3857"})]
                            (assert t "Transformer creation failed")))
                        (println "   OK GraalVM mode test passed")))

                    (println)
                    (println "3. Testing coordinate transformation from JAR...")
                    (run-from-jar!
                     "Transformation test" []
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/init!)
                        (let [ctx (proj/context-create)
                              t (proj/proj-create-crs-to-crs
                                 {:context ctx
                                  :source_crs "EPSG:4326"
                                  :target_crs "EPSG:3857"})
                              coord-array (proj/coord-array 1)
                              _ (proj/set-coords! coord-array [[-74.006 40.7128 0 0]])
                              _ (proj/proj-trans-array
                                 {:p t
                                  :direction 1
                                  :n 1
                                  :coord coord-array})
                              x (get-in coord-array [0 0])
                              y (get-in coord-array [0 1])]
                          (assert (< 4500000 x 4600000) "X coordinate out of range")
                          (assert (< y -12500000) "Y coordinate out of range")
                          (println (format "   OK Transformed NYC: [%.2f, %.2f]" x y)))))

                    (println)
                    (println "4. Testing Java API from JAR...")
                    (let [test-dir "target/java-jar-test"
                          clj-cp (-> (tasks/shell {:out :string} clj-cmd "-Spath") :out str/trim)]
                      (fs/create-dirs test-dir)
                      (spit (str test-dir "/JavaJarTest.java")
                            "import net.willcohen.proj.PROJ;

public class JavaJarTest {
    public static void main(String[] args) {
        try {
            PROJ.init();
            Object ctx = PROJ.contextCreate();
            if (ctx == null) throw new RuntimeException(\"Context creation failed\");
            Object transform = PROJ.createCrsToCrs(ctx, \"EPSG:4326\", \"EPSG:3857\");
            if (transform == null) throw new RuntimeException(\"Transform creation failed\");
            System.out.println(\"   OK Java API test passed\");
        } catch (Exception e) {
            System.err.println(\"Java API test failed: \" + e.getMessage());
            e.printStackTrace();
            System.exit(1);
        }
    }
}
")
                      (let [compile-result (clojure.java.shell/sh
                                            "javac" "--release" "25"
                                            "-cp" (str jar-path path-sep clj-cp)
                                            "-d" test-dir
                                            (str test-dir "/JavaJarTest.java"))]
                        (when (not= 0 (:exit compile-result))
                          (println "Java compilation failed!")
                          (print (:out compile-result))
                          (print (:err compile-result))
                          (System/exit 1)))
                      (let [run-result (clojure.java.shell/sh
                                        "java"
                                        "-XX:+UnlockExperimentalVMOptions"
                                        "-XX:+EnableJVMCI"
                                        "--enable-native-access=ALL-UNNAMED"
                                        "-Dpolyglot.engine.WarnInterpreterOnly=false"
                                        "-cp" (str test-dir path-sep jar-path path-sep clj-cp)
                                        "JavaJarTest")]
                        (print (:out run-result))
                        (when (not= 0 (:exit run-result))
                          (println "Java run failed!")
                          (print (:err run-result))
                          (System/exit 1))))

                    (println)
                    (println "All JAR tests passed!"))}

  build
  {:doc "Build native, wasm, or cross-compiled artifacts. See `bb build --help`."
   :spec {:native {:alias :n, :desc "Build native artifacts for the host platform."}
          :wasm {:alias :w, :desc "Build the single-threaded WASM (used by Node, browser, and GraalVM)."}
          :wasm-browser {:desc "Alias for --wasm. There is only the single-threaded build."}
          :wasm-graal {:desc "Alias for --wasm. There is only the single-threaded build."}
          :cross {:desc "Build cross-compiled artifacts for default platforms."}
          :cross-platform {:desc "Build for a specific cross-platform target (for example linux/amd64)."
                           :coerce :string}
          ;; --debug applies -O0 -g -gsource-map to sqlite, zlib, libtiff,
          ;; proj and the emcc link, and -fsanitize=address to all but
          ;; sqlite: an ASan-instrumented sqlite3VdbeExec exceeds wasm's
          ;; per-function local limit. PROJ gets CMAKE_BUILD_TYPE=Debug, and
          ;; the final link gets ASSERTIONS=2, STACK_OVERFLOW_CHECK=2,
          ;; INITIAL_MEMORY=268435456 and ALLOW_MEMORY_GROWTH=0. ASan's wasm
          ;; stack walker reads the proj-emscripten.wasm.map sidecar from
          ;; -gsource-map for named C++ frames, not the DWARF from -g. The
          ;; sidecar is staged next to the wasm and into dist/, or emscripten
          ;; init hangs while it waits for the file.
          :debug {:desc "Full debug build: -O0 -g, AddressSanitizer, ASSERTIONS=2. Much larger and approximately 5x slower. Do not ship them."}
          :local-proj {:desc "Use local PROJ (default vendor/PROJ, or give a path)."}
          :target {:desc "Internal use: select the target platform for compilation (for example windows-amd64)."
                   :coerce :string}
          :help {:alias :h :desc "Show this help message."}}
   :task (let [opts (cli/parse-opts *command-line-args* {:spec (:spec (tasks/current-task))})]
           (when (:help opts)
             (println "\nUsage: bb build [options]\n")
             (println "Options:")
             (println (cli/format-opts {:spec (:spec (tasks/current-task))
                                       :order [:native :wasm :wasm-browser :wasm-graal
                                               :cross :cross-platform :debug :local-proj
                                               :target :help]}))
             (System/exit 0))

           (let [get-proj-source (fn [opts proj-source target-dir]
                                   (if (:local-proj opts)
                                     (let [local-proj-opt (:local-proj opts)
                                           local-proj (if (or (= local-proj-opt true) (= local-proj-opt "true"))
                                                        (fs/path "vendor" "PROJ")
                                                        (fs/expand-home (str local-proj-opt)))
                                           target-proj-dir "PROJ-local"]
                                       (if (fs/exists? local-proj)
                                         (do
                                           (println (str "Using local PROJ from " local-proj))
                                           (let [target-proj-path (fs/path target-dir target-proj-dir)]
                                             (when (fs/exists? target-proj-path)
                                               (println (str "Removing existing " target-proj-path))
                                               (fs/delete-tree target-proj-path))
                                             (println (str "Copying local PROJ to " target-proj-path "..."))
                                             (if (fs/which "rsync")
                                               (tasks/shell "rsync" "-av" "--exclude=.git"
                                                            (str local-proj "/") (str target-proj-path "/"))
                                               (fs/copy-tree local-proj target-proj-path {:replace-existing true}))
                                             target-proj-dir))
                                         (throw (ex-info "Local PROJ not found. Run 'bb proj:clone' first."
                                                         {:local-proj-path (str local-proj)}))))
                                     (let [{:keys [type ref]} proj-source]
                                       (case type
                                         :tag (str "PROJ-" ref)
                                         :sha (let [git-dir (fs/path target-dir "PROJ-git")]
                                                (if (fs/exists? git-dir)
                                                  (do
                                                    (println (str "Checking out PROJ SHA " ref "..."))
                                                    (tasks/shell {:dir (str git-dir)} "git" "fetch" "origin")
                                                    (tasks/shell {:dir (str git-dir)} "git" "checkout" ref))
                                                  (do
                                                    (println (str "Cloning PROJ repository..."))
                                                    (fs/create-dirs target-dir)
                                                    (tasks/shell {:dir target-dir}
                                                                 "git" "clone"
                                                                 "https://github.com/OSGeo/PROJ.git"
                                                                 "PROJ-git")
                                                    (println (str "Checking out SHA " ref "..."))
                                                    (tasks/shell {:dir (str git-dir)} "git" "checkout" ref)))
                                                "PROJ-git")))))

                 detect-proj-version (fn [proj-source-path]
                                       (if (fs/exists? (fs/path proj-source-path "CMakeLists.txt"))
                                         (try
                                           (let [cmake-content (slurp (fs/path proj-source-path "CMakeLists.txt"))
                                                 version-match (re-find (re-pattern "set\\s*\\(\\s*PROJ_VERSION\\s+\"([^\"]+)\"") cmake-content)]
                                             (if version-match
                                               (second version-match)
                                               "dev"))
                                           (catch Exception _
                                             "dev"))
                                         "dev"))

                 prepare-local-proj (fn [proj-source-path]
                                      (when (and (fs/exists? (fs/path proj-source-path "autogen.sh"))
                                                 (not (fs/exists? (fs/path proj-source-path "configure"))))
                                        (println "Running autogen.sh to prepare local PROJ build...")
                                        (tasks/shell {:dir (str proj-source-path)} "./autogen.sh")))]

             (let [{native? :native, wasm-all? :wasm, wasm-browser-flag :wasm-browser, wasm-graal-flag :wasm-graal, debug? :debug, target-str :target} opts
                   wasm-browser? (or wasm-all? wasm-browser-flag)
                   wasm-graal? (or wasm-all? wasm-graal-flag)
                   wasm? (or wasm-browser? wasm-graal?)
                   target-dir "target"
                   zlib-archive (str "zlib-" zlib-version ".tar.gz")
                   zlib-dir (str "zlib-" zlib-version)
                   sqlite-archive (str "sqlite-autoconf-" sqlite-version-url ".tar.gz")
                   sqlite-dir (str "sqlite-autoconf-" sqlite-version-url)
                   libtiff-archive (str "libtiff-v" libtiff-version ".tar.gz")
                   libtiff-dir (str "libtiff-v" libtiff-version)
                   proj-archive (when (= (:type proj-source) :tag)
                                  (str (:ref proj-source) ".tar.gz"))

                   proj-dir (get-proj-source opts proj-source target-dir)

                   host-os (let [os-name (System/getProperty "os.name")]
                             (cond
                               (re-find (re-pattern "(?i)mac|darwin") os-name) :darwin
                               (re-find (re-pattern "(?i)linux") os-name) :linux
                               :else :unknown))
                   host-arch (let [os-arch (System/getProperty "os.arch")]
                               (cond
                                 (re-find (re-pattern "(?i)aarch64|arm64") os-arch) :aarch64
                                 (re-find (re-pattern "(?i)amd64|x86_64") os-arch) :amd64
                                 :else :unknown))

                   download-file (fn [url dest] (nb/download-archive url dest))
                   extract-archive (fn [archive-file extracted-dir base-dir]
                                     (nb/extract-archive archive-file extracted-dir base-dir))

                   get-safe-parallel-jobs nb/safe-parallel-jobs

                   build-sqlite (fn [{:keys [type install-dir cc host-flag is-linux? is-windows? pthreads? debug?]}]
                                  (let [lib-path (fs/path install-dir "lib" "libsqlite3.a")]
                                    (when debug? (println "DEBUG: Checking for existing" (name type) "SQLite library at:" (str lib-path)))
                                    (when-not (fs/exists? lib-path)
                                      (println "Building SQLite for" (name type) (if pthreads? "(pthreads)" "(single-threaded)") "...")
                                      (let [build-dir (fs/path target-dir sqlite-dir (str "sqlite-build-" (name type) (when (and (= type :wasm) (not pthreads?)) "-st")))
                                            src-dir (fs/path target-dir sqlite-dir)
                                            in-container? (and (= type :native) is-linux? (System/getenv "NIX_BUILD_TOP"))
                                            container-host-flag (when in-container?
                                                                  (let [arch (case (System/getProperty "os.arch")
                                                                               "amd64" "x86_64"
                                                                               "x86_64" "x86_64"
                                                                               "aarch64" "aarch64"
                                                                               "arm64" "aarch64"
                                                                               "unknown")]
                                                                    (str "--host=" arch "-pc-linux-musl")))
                                            configure-args (cond-> []
                                                             host-flag (conj host-flag)
                                                             (and container-host-flag (not host-flag)) (conj container-host-flag)
                                                             (= type :wasm) (conj "--disable-shared" "--disable-editline" "--disable-readline")
                                                             (and (= type :native) is-linux?) (conj "--disable-shared" "--enable-static")
                                                             is-windows? (conj "--disable-shared" "--enable-static"))
                                            ;; SQLITE_MAX_WORKER_THREADS=0 stops all pthread_create calls in
                                            ;; SQLite. With the default (8) under emscripten, a sub-Worker's
                                            ;; TLS init raced the parent in dlmalloc and hit musl's same-tid
                                            ;; deadlock assert. CRS lookups in proj.db are small, so a serial
                                            ;; sort has no cost.
                                            wasm-cflags (str (when pthreads? "-pthread -DSQLITE_THREADSAFE=1 -DSQLITE_MAX_WORKER_THREADS=0 ")
                                                             (when-not pthreads? "-DSQLITE_THREADSAFE=0 ")
                                                             ;; No -fsanitize=address here. ASan adds shadow locals for
                                                             ;; each C local, and sqlite3VdbeExec then exceeds wasm's
                                                             ;; per-function local limit ("local count too large" at
                                                             ;; instantiation). The link-level ASan runtime still
                                                             ;; intercepts malloc/free, so heap corruption from PROJ
                                                             ;; that crashes in sqlite's allocator stays visible.
                                                             (when debug? "-O0 -g -gsource-map ")
                                                             "-s ERROR_ON_UNDEFINED_SYMBOLS=0 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DISABLE_LFS -DSQLITE_LONGDOUBLE_TYPE=double -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_NORMALIZE")
                                            env (cond-> {"CC" cc}
                                                  (and (= type :native) is-linux?) (assoc "CFLAGS" "-fPIC")
                                                  is-windows? (assoc "CFLAGS" (or (System/getenv "CFLAGS") "-static-libgcc -static-libstdc++")
                                                                     "LDFLAGS" (or (System/getenv "LDFLAGS") "-static-libgcc -static-libstdc++"))
                                                  (= type :wasm) (assoc "CFLAGS" wasm-cflags))]
                                        (nb/build-autotools-library
                                         {:type type
                                          :src-dir src-dir
                                          :build-dir build-dir
                                          :install-dir install-dir
                                          :configure-args configure-args
                                          :env env})))))

                   build-zlib (fn [{:keys [type install-dir cc pthreads? debug?]}]
                                (let [lib-path (fs/path install-dir "lib" "libz.a")]
                                  (when debug? (println "DEBUG: Checking for existing" (name type) "zlib library at:" (str lib-path)))
                                  (when-not (fs/exists? lib-path)
                                    (println "Building zlib for" (name type) (if pthreads? "(pthreads)" "(single-threaded)") "...")
                                    (let [src-dir (fs/path target-dir zlib-dir)
                                          env (cond-> {"CC" cc}
                                                (= type :wasm) (assoc "AR" "emar" "RANLIB" "emranlib")
                                                (and (= type :wasm) pthreads?) (assoc "CFLAGS" "-pthread")
                                                (and (= type :wasm) debug?)
                                                (update "CFLAGS" (fn [v] (str (or v "") " -O0 -g -gsource-map -fsanitize=address"))))
                                          patch-wasm-makefile
                                          (fn []
                                            ;; zlib's configure ignores AR and RANLIB on WASM and uses
                                            ;; libtool. Patch the Makefile to use emar.
                                            (let [makefile-path (str (fs/path src-dir "Makefile"))
                                                  content (slurp makefile-path)
                                                  patched (-> content
                                                              (str/replace (re-pattern "(?m)^AR=.*$") "AR=emar")
                                                              (str/replace (re-pattern "(?m)^ARFLAGS=.*$") "ARFLAGS=rcs")
                                                              (str/replace (re-pattern "(?m)^RANLIB=.*$") "RANLIB=emranlib")
                                                              (str/replace "/usr/bin/libtool -o" "emar rcs")
                                                              (str/replace "libtool -o" "emar rcs"))]
                                              (spit makefile-path patched)
                                              (println "Patched zlib Makefile to use emar for WASM")))]
                                      (nb/build-autotools-library
                                       {:type type
                                        :build-dir src-dir
                                        :install-dir install-dir
                                        :in-tree? true
                                        :configure-args ["--static"]
                                        :env env
                                        :post-configure (when (= type :wasm) patch-wasm-makefile)})))))

                   build-libtiff (fn [{:keys [type install-dir zlib-install-dir cc cxx host-flag is-darwin? is-linux? is-windows? pthreads? debug?]}]
                                   (let [lib-path (fs/path install-dir "lib" "libtiff.a")]
                                     (when debug? (println "DEBUG: Checking for existing" (name type) "LibTIFF library at:" (str lib-path)))
                                     (when-not (fs/exists? lib-path)
                                       (println "Building LibTIFF for" (name type) (if pthreads? "(pthreads)" "(single-threaded)") "...")
                                       (let [src-dir (fs/path target-dir libtiff-dir)
                                             in-container? (and (= type :native) is-linux? (System/getenv "NIX_BUILD_TOP"))
                                             container-host-flag (when in-container?
                                                                   (let [arch (case (System/getProperty "os.arch")
                                                                                "amd64" "x86_64"
                                                                                "x86_64" "x86_64"
                                                                                "aarch64" "aarch64"
                                                                                "arm64" "aarch64"
                                                                                "unknown")]
                                                                     (str "--host=" arch "-pc-linux-musl")))
                                             configure-args (cond-> []
                                                              host-flag (conj host-flag)
                                                              (and container-host-flag (not host-flag)) (conj container-host-flag)
                                                              (= type :native) (conj "--disable-shared" "--enable-static" "--disable-zstd")
                                                              in-container? (conj "--disable-cxx")
                                                              (and (not= type :wasm) (not= type :native)) (conj "--disable-tools" "--disable-contrib" "--disable-tests" "--disable-docs")
                                                              (and (= type :native) zlib-install-dir) (conj (str "--with-zlib-include-dir=" (fs/path zlib-install-dir "include"))
                                                                                                            (str "--with-zlib-lib-dir=" (fs/path zlib-install-dir "lib")))
                                                              (= type :wasm) (conj (str "--with-zlib-include-dir=" (fs/path zlib-install-dir "include"))
                                                                                   (str "--with-zlib-lib-dir=" (fs/path zlib-install-dir "lib"))
                                                                                   "--disable-zstd" "--disable-tools" "--disable-contrib" "--disable-tests" "--disable-docs" "--disable-ccitt"))
                                             env (cond-> {"CC" cc "CXX" cxx}
                                                   (and (= type :native) is-linux?) (assoc "CFLAGS" "-fPIC" "CXXFLAGS" "-fPIC")
                                                   (= type :wasm) (assoc "CPPFLAGS" "-DHAVE_FCNTL_H=1")
                                                   (and (= type :wasm) pthreads?) (assoc "CFLAGS" "-pthread" "CXXFLAGS" "-pthread")
                                                   (and (= type :wasm) debug?)
                                                   (update "CFLAGS" (fn [v] (str (or v "") " -O0 -g -gsource-map -fsanitize=address")))
                                                   (and (= type :wasm) debug?)
                                                   (update "CXXFLAGS" (fn [v] (str (or v "") " -O0 -g -gsource-map -fsanitize=address"))))
                                             patch-wasm-makefile
                                             (fn []
                                               ;; mkg3states is a native-only tool. For WASM, patch
                                               ;; libtiff/Makefile to skip it and write a dummy tif_fax3sm.c.
                                               (println "Patching libtiff Makefile to skip mkg3states for WASM...")
                                               (let [makefile-path (str (fs/path src-dir "libtiff" "Makefile"))
                                                     content (slurp makefile-path)
                                                     patched (-> content
                                                                 (str/replace (re-pattern "noinst_PROGRAMS = mkg3states") "noinst_PROGRAMS =")
                                                                 (str/replace (re-pattern "mkg3states:") "# mkg3states:")
                                                                 (str/replace (re-pattern "mkg3states\\.o") "# mkg3states.o"))]
                                                 (spit makefile-path patched))
                                               (let [fax3sm-path (fs/path src-dir "libtiff" "tif_fax3sm.c")]
                                                 (when-not (fs/exists? fax3sm-path)
                                                   (println "Creating dummy tif_fax3sm.c...")
                                                   (spit (str fax3sm-path) "/* Dummy file for WASM build */"))))]
                                         (when (fs/exists? (fs/path src-dir "Makefile"))
                                           (try
                                             (tasks/shell {:dir src-dir} "make" "distclean")
                                             (catch Exception e
                                               (println "Warning: make distclean failed, continuing anyway:" (.getMessage e)))))
                                         (fs/delete-if-exists (fs/path src-dir "config.status"))
                                         (fs/delete-if-exists (fs/path src-dir "config.cache"))
                                         (fs/delete-if-exists (fs/path src-dir "Makefile"))
                                         (fs/delete-if-exists (fs/path src-dir "libtool"))
                                         (when is-darwin?
                                           (tasks/shell {:dir src-dir} "sed" "-i.bak" "s/glibtoolize/libtoolize/g" "autogen.sh"))
                                         (try (tasks/shell {:dir src-dir :extra-env env} "./autogen.sh")
                                              (catch Exception _
                                                (println "autogen.sh failed, patching and retrying...")
                                                (tasks/shell {:dir src-dir} "sed" "-i.bak" "s|https://git.savannah.gnu.org/cgit/config.git/plain/|https://raw.githubusercontent.com/cgitmirror/config/refs/heads/master/|g" "autogen.sh")
                                                (tasks/shell {:dir src-dir :extra-env env} "./autogen.sh")))
                                         (nb/build-autotools-library
                                          {:type type
                                           :build-dir src-dir
                                           :install-dir install-dir
                                           :in-tree? true
                                           :configure-args configure-args
                                           :env env
                                           :post-configure (when (= type :wasm) patch-wasm-makefile)})))))

                   build-proj (fn [{:keys [type library-dir cc cxx host-flag is-darwin? is-linux? is-windows? sqlite-install-dir zlib-install-dir libtiff-install-dir pthreads? debug? target-str]}]
                                (let [wasm-suffix (if (and (= type :wasm) (not pthreads?)) "-st" "")
                                      final-proj-lib (fs/path "resources" (if (= type :wasm) "wasm" library-dir)
                                                              (cond (= type :wasm) (str "proj-emscripten" wasm-suffix ".js")
                                                                    is-windows? "proj.dll"
                                                                    is-darwin? "libproj.dylib"
                                                                    is-linux? "libproj.so"
                                                                    :else "libproj.a"))
                                      build-dir (fs/path target-dir proj-dir (str "proj-build-" (if (= type :native) library-dir (name type)) wasm-suffix))]
                                  (when debug? (println "DEBUG: Checking for existing" (name type) "PROJ library at:" (str final-proj-lib)))
                                  (when-not (fs/exists? final-proj-lib)
                                    (println "Building PROJ for" (name type) "...")
                                    (when (and (not is-darwin?) (System/getenv "NIX_BUILD_TOP"))
                                      (let [cmake-file (fs/path target-dir proj-dir "CMakeLists.txt")
                                            content (slurp (str cmake-file))
                                            patched (str/replace content
                                                                 "add_subdirectory(scripts)"
                                                                 "# add_subdirectory(scripts) - Skipped for cross-compilation")]
                                        (spit (str cmake-file) patched)))

                                    (let [is-nix-build? (and (not is-darwin?) (System/getenv "NIX_BUILD_TOP"))
                                          is-cross-build? (and target-str (not= type :wasm))
                                          ;; No -fwasm-exceptions. GraalWasm has implemented the
                                          ;; exception handling proposal since 25.1, and node and
                                          ;; current browsers support it, but emscripten 6.0.6 cannot
                                          ;; link it: its LLVM emits calls to _Unwind_CallPersonality
                                          ;; while its own libunwind-wasmexcept.a (Unwind-wasm.o)
                                          ;; defines every other _Unwind_* routine and not that one.
                                          ;; Reproduced on a two-line C++ file with no PROJ involved,
                                          ;; under WASM_LEGACY_EXCEPTIONS 0 and 1 alike. Recheck after
                                          ;; an emscripten bump; upstream LLVM is removing the
                                          ;; indirection (llvm-project PR 175202).
                                          base-cxx-flags "-ftemplate-depth=256"
                                          cmake-args (cond-> ["-DBUILD_APPS=OFF" "-DBUILD_PROJSYNC=OFF" "-DBUILD_CCT=OFF" "-DBUILD_GEOD=OFF" "-DBUILD_GIE=OFF" "-DBUILD_PROJINFO=OFF" "-DBUILD_TESTING=OFF"
                                                              (str "-DCMAKE_BUILD_TYPE=" (if debug? "Debug" "Release"))
                                                              "-DCMAKE_DISABLE_FIND_PACKAGE_nlohmann_json=ON"
                                                              "-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
                                                              (str "-DCMAKE_INSTALL_PREFIX=" build-dir)
                                                              (str "-DCMAKE_CXX_FLAGS=" base-cxx-flags)
                                                              (str "-DSQLite3_INCLUDE_DIR=" (fs/path sqlite-install-dir "include"))
                                                              (str "-DSQLite3_LIBRARY=" (fs/path sqlite-install-dir "lib" "libsqlite3.a"))
                                                              (str "-DTIFF_INCLUDE_DIR=" (fs/path libtiff-install-dir "include"))
                                                              (str "-DTIFF_LIBRARY=" (fs/path libtiff-install-dir "lib" "libtiff.a"))
                                                              (str "-DZLIB_INCLUDE_DIR=" (fs/path zlib-install-dir "include"))
                                                              (str "-DZLIB_LIBRARY=" (fs/path zlib-install-dir "lib" "libz.a"))]

                                                       is-darwin? (conj "-DCMAKE_INSTALL_RPATH=@loader_path")
                                                       is-windows? (conj "-DCMAKE_SYSTEM_NAME=Windows"
                                                                         "-DCMAKE_C_FLAGS=-static-libgcc -static-libstdc++ -static"
                                                                         "-DCMAKE_CXX_FLAGS=-static-libgcc -static-libstdc++ -static"
                                                                         "-DCMAKE_SHARED_LINKER_FLAGS=-static-libgcc -static-libstdc++ -static -Wl,--enable-auto-import -lws2_32 -lcrypt32 -lbcrypt"
                                                                         "-DCMAKE_EXE_LINKER_FLAGS=-static-libgcc -static-libstdc++ -static -lws2_32 -lcrypt32 -lbcrypt"
                                                                         "-DBUILD_SHARED_LIBS=ON"
                                                                         "-DCMAKE_DL_LIBS="
                                                                         "-DHAVE_DLADDR=0"
                                                                         "-DCMAKE_CROSSCOMPILING=ON"
                                                                         "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded"
                                                                         "-DCMAKE_DISABLE_FIND_PACKAGE_PkgConfig=ON"
                                                                         (str "-DCMAKE_CXX_STANDARD_LIBRARIES="
                                                                              (fs/path zlib-install-dir "lib" "libz.a")
                                                                              " -lws2_32 -lcrypt32 -lbcrypt"))

                                                       (and (or is-nix-build? is-cross-build?) (not is-windows?)) (conj "-DCMAKE_SYSTEM_NAME=Linux"
                                                                                                                        "-DCMAKE_CROSSCOMPILING=ON"
                                                                                                                        "-DCMAKE_C_COMPILER_WORKS=TRUE"
                                                                                                                        "-DCMAKE_CXX_COMPILER_WORKS=TRUE"
                                                                                                                        "-DCMAKE_C_ABI_COMPILED=TRUE"
                                                                                                                        "-DCMAKE_CXX_ABI_COMPILED=TRUE"
                                                                                                                        "-DCMAKE_C_COMPILE_FEATURES=c_std_99"
                                                                                                                        "-DCMAKE_CXX_COMPILE_FEATURES=cxx_std_17"
                                                                                                                        "-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY"
                                                                                                                        "-DCMAKE_DISABLE_FIND_PACKAGE_Dlfcn=ON"
                                                                                                                        "-DHAVE_DLADDR=0"
                                                                                                                        "-DHAVE_LOCALECONV=1"
                                                                                                                        "-DHAVE_STRERROR=1"
                                                                                                                        "-DCMAKE_DISABLE_FIND_PACKAGE_Threads=ON"
                                                                                                                        "-DCMAKE_HAVE_LIBC_PTHREAD=NO"
                                                                                                                        "-DCMAKE_USE_PTHREADS_INIT=NO"
                                                                                                                        "-DCMAKE_USE_WIN32_THREADS_INIT=NO"
                                                                                                                        "-DCMAKE_C_STANDARD_COMPUTED_DEFAULT=99"
                                                                                                                        "-DCMAKE_CXX_STANDARD_COMPUTED_DEFAULT=17"
                                                                                                                        (str "-DCMAKE_SYSTEM_PROCESSOR="
                                                                                                                             (if target-str
                                                                                                                               (case (second (str/split target-str (re-pattern "-")))
                                                                                                                                 "amd64" "x86_64"
                                                                                                                                 "aarch64" "aarch64"
                                                                                                                                 "arm64" "aarch64"
                                                                                                                                 "x86_64")
                                                                                                                               (case (System/getProperty "os.arch")
                                                                                                                                 "amd64" "x86_64"
                                                                                                                                 "x86_64" "x86_64"
                                                                                                                                 "aarch64" "aarch64"
                                                                                                                                 "arm64" "aarch64"
                                                                                                                                 "x86_64")))
                                                                                                                        "-DCMAKE_INSTALL_LIBDIR=lib"
                                                                                                                        "-DCMAKE_CROSSCOMPILING_EMULATOR=/bin/false"
                                                                                                                        "-DCMAKE_DISABLE_FIND_PACKAGE_nlohmann_json=ON"
                                                                                                                        "-DUSE_EXTERNAL_NLOHMANN_JSON=OFF"
                                                                                                                        "-DNLOHMANN_JSON_FOUND=FALSE"
                                                                                                                        "-DCMAKE_DISABLE_FIND_PACKAGE_PkgConfig=ON")
                                                       (and target-str is-windows? (not= type :wasm)) (conj "-DCMAKE_CROSSCOMPILING=ON"
                                                                                                            "-DCMAKE_C_COMPILER_WORKS=TRUE"
                                                                                                            "-DCMAKE_CXX_COMPILER_WORKS=TRUE"
                                                                                                            "-DCMAKE_C_ABI_COMPILED=TRUE"
                                                                                                            "-DCMAKE_CXX_ABI_COMPILED=TRUE"
                                                                                                            "-DCMAKE_SIZEOF_VOID_P=8")
                                                       (= type :native) (conj "-DENABLE_CURL=OFF"
                                                                              "-DENABLE_NETWORK=ON")
                                                       (and (= type :native) is-darwin?) (conj "-DBUILD_SHARED_LIBS=ON"
                                                                                               (str "-DCMAKE_CXX_STANDARD_LIBRARIES="
                                                                                                    (fs/path zlib-install-dir "lib" "libz.a")))
                                                       (and (= type :native) is-linux?) (conj "-DBUILD_SHARED_LIBS=ON"
                                                                                              "-DCMAKE_SHARED_LINKER_FLAGS=-static-libgcc -static-libstdc++ -Wl,-Bstatic -lc -lm -Wl,-Bdynamic -Wl,--no-as-needed"
                                                                                              "-DCMAKE_SHARED_LINKER_FLAGS_INIT=-Wl,-Bstatic -lc -lm -Wl,-Bdynamic"
                                                                                              "-DCMAKE_FIND_LIBRARY_SUFFIXES=.a"
                                                                                              "-DCMAKE_SKIP_RPATH=ON")
                                                       (and (= type :native) is-linux?) (conj (str "-DCMAKE_CXX_STANDARD_LIBRARIES="
                                                                                                   (fs/path zlib-install-dir "lib" "libz.a")))
                                                       (= type :wasm) (conj "-DBUILD_SHARED_LIBS=OFF"
                                                                            "-DCMAKE_POLICY_DEFAULT_CMP0135=NEW"
                                                                            "-DEMBED_RESOURCE_FILES=OFF"
                                                                            "-DENABLE_CURL=OFF")
                                                       (and (= type :wasm) pthreads?) (conj "-DENABLE_EMSCRIPTEN_FETCH=ON"
                                                                                            (str "-DCMAKE_C_FLAGS=-pthread" (when debug? " -fsanitize=address"))
                                                                                            (str "-DCMAKE_CXX_FLAGS=-pthread" (when debug? " -fsanitize=address")))
                                                       (and (= type :wasm) (not pthreads?)) (conj "-DENABLE_EMSCRIPTEN_FETCH=OFF")
                                                       (and (= type :wasm) (not pthreads?) debug?) (conj "-DCMAKE_C_FLAGS=-fsanitize=address"
                                                                                                         (str "-DCMAKE_CXX_FLAGS=" base-cxx-flags " -fsanitize=address")))]
                                      (let [cmake-env (cond-> {"CXX" cxx "CC" cc "CMAKE_VERBOSE_MAKEFILE" "TRUE"}
                                                        (and (= type :native) is-linux?) (assoc "LDFLAGS" "-static-libgcc -static-libstdc++ -Wl,-Bstatic -lc -Wl,-Bdynamic"))
                                            ;; Absolute, like :src-dir below. cmake runs with
                                            ;; its working directory set to build-dir and
                                            ;; resolves -C against it, so a relative path
                                            ;; here becomes build-dir/build-dir/... and the
                                            ;; configure step fails with "Not a file".
                                            cache-file (fs/absolutize (fs/path build-dir "initial-cache.cmake"))
                                            write-cache (fn []
                                                          (spit (str cache-file)
                                                                (str "# Initial cache to skip tests and prevent hanging\n"
                                                                     "set(CMAKE_CROSSCOMPILING ON CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING \"\")\n"
                                                                     "set(CMAKE_C_COMPILER_WORKS TRUE CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_CXX_COMPILER_WORKS TRUE CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_C_ABI_COMPILED TRUE CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_CXX_ABI_COMPILED TRUE CACHE BOOL \"\")\n"
                                                                     "set(Threads_FOUND FALSE CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_THREAD_LIBS_INIT \"\" CACHE STRING \"\")\n"
                                                                     "set(CMAKE_USE_PTHREADS_INIT OFF CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_USE_WIN32_THREADS_INIT OFF CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_HP_PTHREADS_INIT OFF CACHE BOOL \"\")\n"
                                                                     "set(HAVE_PTHREAD_H OFF CACHE BOOL \"\")\n"
                                                                     "set(HAVE_PTHREAD_CREATE OFF CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_INSTALL_LIBDIR lib CACHE STRING \"\")\n"
                                                                     "set(HAVE_DLADDR 0 CACHE INTERNAL \"\")\n"
                                                                     "set(HAVE_LOCALECONV 1 CACHE INTERNAL \"\")\n"
                                                                     "set(HAVE_STRERROR 1 CACHE INTERNAL \"\")\n"
                                                                     "set(nlohmann_json_FOUND FALSE CACHE BOOL \"\")\n"
                                                                     "set(PkgConfig_FOUND FALSE CACHE BOOL \"\")\n"
                                                                     "set(CMAKE_C_COMPILE_FEATURES c_std_99 CACHE STRING \"\")\n"
                                                                     "set(CMAKE_CXX_COMPILE_FEATURES cxx_std_17 CACHE STRING \"\")\n"
                                                                     "set(CMAKE_CROSSCOMPILING_EMULATOR /bin/false CACHE STRING \"\")\n"
                                                                     "set(HAVE_EXP 1 CACHE INTERNAL \"\")\n"
                                                                     "set(HAVE_LOG 1 CACHE INTERNAL \"\")\n"
                                                                     "set(HAVE_SQRT 1 CACHE INTERNAL \"\")\n"
                                                                     "set(MATH_LIBRARY m CACHE STRING \"\")\n"
                                                                     "set(CMAKE_REQUIRED_LIBRARIES m CACHE STRING \"\")\n"
                                                                     "set(CMAKE_DL_LIBS dl CACHE STRING \"\")\n"
                                                                     "set(DL_LIBRARY dl CACHE STRING \"\")\n"
                                                                     "set(CMAKE_THREAD_LIBS_INIT \"-lpthread\" CACHE STRING \"\")\n"
                                                                     "set(CMAKE_USE_PTHREADS_INIT 1 CACHE INTERNAL \"\")\n"
                                                                     "set(CMAKE_HAVE_LIBC_PTHREAD 1 CACHE INTERNAL \"\")\n")))]
                                        (try
                                          (nb/build-cmake-library
                                           {:type type
                                            :src-dir (fs/absolutize (fs/path target-dir proj-dir))
                                            :build-dir build-dir
                                            :cmake-args cmake-args
                                            :env cmake-env
                                            :install? false
                                            :cache-file (when is-nix-build? cache-file)
                                            :pre-configure (when is-nix-build? write-cache)})
                                          (catch Exception e
                                            (let [error-log (fs/path build-dir "CMakeFiles" "CMakeError.log")
                                                  output-log (fs/path build-dir "CMakeFiles" "CMakeOutput.log")]
                                              (when (fs/exists? error-log)
                                                (println "=== CMake Error Log ===")
                                                (println (slurp (str error-log))))
                                              (when (fs/exists? output-log)
                                                (println "=== CMake Output Log (last 100 lines) ===")
                                                (let [lines (str/split-lines (slurp (str output-log)))]
                                                  (println (str/join "\n" (take-last 100 lines)))))
                                              (throw e))))))
                                    (cond
                                      (= type :wasm)
                                      (let [_ (require 'net.willcohen.proj.fndefs)
                                            fndefs-map (deref (resolve 'net.willcohen.proj.fndefs/fndefs))

                                            proj-function-names (->> (keys fndefs-map)
                                                                     (map name)
                                                                     (map (fn [s] (str "_" (str/replace s "-" "_"))))
                                                                     sort)

                                            emscripten-functions ["UTF8ArrayToString"
                                                                  "UTF8ToString"
                                                                  "___get_exception_message"
                                                                  "_emscripten_stack_get_base"
                                                                  "_emscripten_stack_get_current"
                                                                  "_emscripten_stack_get_end"
                                                                  "_emscripten_stack_get_free"
                                                                  "_emscripten_stack_init"
                                                                  "_emscripten_stack_set_limits"
                                                                  "_free"
                                                                  "lengthBytesUTF8"
                                                                  "_malloc"]

                                            all-functions (concat emscripten-functions proj-function-names)
                                            runtime-methods ["FS" "ENV" "HEAPF64" "HEAPU8" "err"
                                                             "ccall" "cwrap" "stackAlloc" "stackSave" "stackRestore"
                                                             "getValue" "setValue" "stringToNewUTF8" "stringToUTF8"
                                                             "UTF8ToString" "addFunction"]]
                                        (fs/copy (fs/path build-dir "data" "proj.db") (fs/path build-dir "proj.db"))
                                        (fs/copy (fs/path build-dir "data" "proj.ini") (fs/path build-dir "proj.ini"))
                                        (let [output-name (str "proj-emscripten" wasm-suffix ".js")
                                              proj-src-include (str (fs/absolutize (fs/path target-dir proj-dir "src")))]
                                          ;; No Asyncify: it hung tests after fetch completion and adds
                                          ;; approximately 10% binary size. PROJ blocks freely inside a
                                          ;; worker instead.
                                          (println "Building" (if pthreads? "pthreads" "single-threaded") "WASM:" output-name)
                                          (nb/emcc-link
                                           {:build-dir build-dir
                                            :output-name output-name
                                            :objects ["lib/libproj.a"
                                                      (str (fs/path libtiff-install-dir "lib" "libtiff.a"))
                                                      (str (fs/path zlib-install-dir "lib" "libz.a"))
                                                      (str (fs/path sqlite-install-dir "lib" "libsqlite3.a"))]
                                            :optimization (if debug? "-O0" "-O2")
                                            ;; ASan's wasm stack walker reads the -gsource-map sidecar,
                                            ;; not the DWARF from -g, for named C++ frames. The
                                            ;; .wasm.map sidecar must sit next to the wasm in dist/, or
                                            ;; emscripten init hangs on its source-map runDependency
                                            ;; (copied below and in esbuild.config.mjs).
                                            :extra-flags (cond-> ["-I" proj-src-include "-s" "ASSERTIONS=1"]
                                                           debug? (into ["-g"
                                                                         "-gsource-map"
                                                                         "-sASSERTIONS=2"
                                                                         "-sSTACK_OVERFLOW_CHECK=2"
                                                                         "-fsanitize=address"
                                                                         "-sINITIAL_MEMORY=268435456"]))
                                            :exported-functions all-functions
                                            :exported-runtime-methods runtime-methods
                                            :pthreads? pthreads?
                                            :allow-memory-growth? (not debug?)
                                            :maximum-memory 2147483648
                                            :module-name "PROJModule"})))

                                      (= type :native)
                                      (let [find-proj-lib (fn [build-dir is-windows? is-darwin? is-linux?]
                                                            (let [lib-dir (fs/path build-dir "lib")
                                                                  bin-dir (fs/path build-dir "bin")]
                                                              (cond
                                                                is-windows?
                                                                ;; Windows DLLs are in bin/, not lib/
                                                                (->> (concat (fs/glob bin-dir "libproj*.dll")
                                                                             (fs/glob bin-dir "proj*.dll"))
                                                                     (map fs/file-name)
                                                                     first)
                                                                is-darwin?
                                                                (->> (fs/glob lib-dir "libproj*.dylib")
                                                                     (map fs/file-name)
                                                                     first)
                                                                is-linux?
                                                                (->> (fs/glob lib-dir "libproj*.{a,so}")
                                                                     (map fs/file-name)
                                                                     first)
                                                                :else
                                                                (->> (fs/glob lib-dir "libproj*.a")
                                                                     (map fs/file-name)
                                                                     first))))

                                            detected-lib (find-proj-lib build-dir is-windows? is-darwin? is-linux?)
                                            fallback-version (detect-proj-version (fs/path target-dir proj-dir))
                                            proj-lib-versioned (or detected-lib
                                                                   (cond
                                                                     is-windows? (str "proj-" (first (str/split fallback-version (re-pattern "\\."))) ".dll")
                                                                     is-darwin? (str "libproj.25." fallback-version ".dylib")
                                                                     is-linux? "libproj.a"
                                                                     :else "libproj.a"))
                                            _ (when debug?
                                                (println (format "DEBUG: Detected PROJ library file: %s (in %s/lib/)"
                                                                 (or detected-lib "none found - using fallback")
                                                                 build-dir))
                                                (when detected-lib
                                                  (println (format "DEBUG: Using detected file: %s" proj-lib-versioned))))]

                                        (let [dest-dir (fs/path "resources" library-dir)]
                                          (println "Copying native build artifacts...")
                                          (fs/create-dirs dest-dir)
                                          (let [source-path (if is-windows?
                                                              (fs/path build-dir "bin" proj-lib-versioned)
                                                              (fs/path build-dir "lib" proj-lib-versioned))]
                                            (fs/copy source-path final-proj-lib {:replace-existing true}))
                                          (when (and is-linux? (= type :native))
                                            (println "Verifying Linux shared library dependencies...")
                                            (println "DEBUG: Checking library file:" (str final-proj-lib))
                                            ;; readelf is more often available than ldd.
                                            (let [readelf-result (shell/sh "readelf" "-d" (str final-proj-lib))]
                                              (if (zero? (:exit readelf-result))
                                                (let [output (:out readelf-result)
                                                      needed-libs (filter (fn [line] (str/includes? line "NEEDED"))
                                                                          (str/split-lines output))]
                                                  (println "DEBUG: Found NEEDED entries:")
                                                  (doseq [lib needed-libs]
                                                    (println "  " lib))

                                                  (let [problematic-deps (filter (fn [lib] (or (str/includes? lib "libc.so")
                                                                                               (str/includes? lib "musl")
                                                                                               (str/includes? lib "/nix/store")))
                                                                                 needed-libs)]
                                                    (if (seq problematic-deps)
                                                      (do
                                                        (println "WARNING: Shared library has unexpected dynamic dependencies:")
                                                        (doseq [dep problematic-deps]
                                                          (println "  " dep))
                                                        (println "This may cause native library loading failures at runtime.")
                                                        (let [patchelf-result (shell/sh "which" "patchelf")]
                                                          (when (zero? (:exit patchelf-result))
                                                            (println "Attempting to remove dynamic dependencies with patchelf...")
                                                            (let [remove-result (shell/sh "patchelf" "--remove-needed" "libc.so" (str final-proj-lib))]
                                                              (if (zero? (:exit remove-result))
                                                                (println "Successfully removed libc.so dependency")
                                                                (println "Failed to remove dependency:" (:err remove-result)))))))
                                                      (println "No problematic dependencies found!")))

                                                  (when debug?
                                                    (println "Full readelf output:")
                                                    (println output)))
                                                (do
                                                  (println "ERROR: readelf failed to analyze library")
                                                  (println "Exit code:" (:exit readelf-result))
                                                  (println "Error:" (:err readelf-result))
                                                  (let [ldd-result (shell/sh "ldd" (str final-proj-lib))]
                                                    (if (zero? (:exit ldd-result))
                                                      (println "Fallback ldd output:" (:out ldd-result))
                                                      (println "Both readelf and ldd unavailable")))))))
                                          (fs/copy (fs/path build-dir "data" "proj.db") (fs/path "resources") {:replace-existing true})
                                          (fs/copy (fs/path build-dir "data" "proj.ini") (fs/path "resources") {:replace-existing true})))))))]

               (when debug?
                 (println "DEBUG: Detected host-os:" host-os)
                 (println "DEBUG: Detected host-arch:" host-arch))

               (fs/create-dirs "target")

               (download-file (str "https://zlib.net/" zlib-archive) (fs/path target-dir zlib-archive))
               (extract-archive zlib-archive zlib-dir target-dir)

               (download-file (str "https://sqlite.org/" sqlite-year "/" sqlite-archive) (fs/path target-dir sqlite-archive))
               (extract-archive sqlite-archive sqlite-dir target-dir)

               (download-file (str "https://gitlab.com/libtiff/libtiff/-/archive/v" libtiff-version "/" libtiff-archive) (fs/path target-dir libtiff-archive))
               (extract-archive libtiff-archive libtiff-dir target-dir)

               (when (and (not (:local-proj opts))
                          (= (:type proj-source) :tag))
                 (download-file (str "https://github.com/OSGeo/PROJ/archive/refs/tags/" proj-archive)
                                (fs/path target-dir proj-archive))
                 (extract-archive proj-archive (str "PROJ-" (:ref proj-source)) target-dir))

               (when (:local-proj opts)
                 (prepare-local-proj (fs/path target-dir proj-dir)))

               (when native?
                 (let [[target-os-str target-arch-str] (if target-str (str/split target-str (re-pattern "-")) [nil nil])
                       target-os (when target-os-str (keyword target-os-str))
                       target-arch (when target-arch-str (keyword target-arch-str))
                       effective-os (or target-os host-os)
                       effective-arch (or target-arch host-arch)
                       is-windows? (= effective-os :windows)
                       is-darwin? (= effective-os :darwin)
                       is-linux? (= effective-os :linux)

                       cc (or (System/getenv "CC") "clang")
                       cxx (or (System/getenv "CXX") "clang++")
                       library-dir (str (name effective-os) "-" (name effective-arch))
                       host-triple (when target-str
                                     (cond
                                       (= target-str "linux-amd64") "x86_64-pc-linux-musl"
                                       (= target-str "linux-aarch64") "aarch64-pc-linux-musl"
                                       (= target-str "windows-amd64") "x86_64-w64-mingw32"
                                       (= target-str "windows-arm64") "aarch64-w64-mingw32"
                                       :else nil))
                       host-flag (when host-triple (str "--host=" host-triple))
                       sqlite-install-dir (fs/absolutize (fs/path "target" (str "sqlite-install-" library-dir)))
                       zlib-install-dir (fs/absolutize (fs/path "target" (str "zlib-install-" library-dir)))
                       libtiff-install-dir (fs/absolutize (fs/path "target" (str "libtiff-install-" library-dir)))]

                   (println "--> Starting native build for" (if target-str (str target-str " (cross-compile)") library-dir))

                   (let [final-proj-lib (fs/path "resources" library-dir
                                                 (cond is-windows? "proj.dll"
                                                       is-darwin? "libproj.dylib"
                                                       is-linux? "libproj.so"
                                                       :else "libproj.a"))]
                     (if (fs/exists? final-proj-lib)
                       (println "Skipping build - PROJ library already exists at:" (str final-proj-lib))
                       (do
                         (build-sqlite {:type :native
                                        :install-dir sqlite-install-dir
                                        :cc cc
                                        :host-flag host-flag
                                        :is-linux? is-linux?
                                        :is-windows? is-windows?
                                        :debug? debug?})

                         (build-zlib {:type :native
                                      :install-dir zlib-install-dir
                                      :cc cc
                                      :debug? debug?})

                         (build-libtiff {:type :native
                                         :install-dir libtiff-install-dir
                                         :zlib-install-dir zlib-install-dir
                                         :cc cc
                                         :cxx cxx
                                         :host-flag host-flag
                                         :is-darwin? is-darwin?
                                         :is-linux? is-linux?
                                         :is-windows? is-windows?
                                         :debug? debug?})

                         (build-proj {:type :native
                                      :library-dir library-dir
                                      :cc cc
                                      :cxx cxx
                                      :host-flag host-flag
                                      :is-linux? is-linux?
                                      :is-darwin? is-darwin?
                                      :is-windows? is-windows?
                                      :sqlite-install-dir sqlite-install-dir
                                      :zlib-install-dir zlib-install-dir
                                      :libtiff-install-dir libtiff-install-dir
                                      :debug? debug?
                                      :target-str target-str}))))))

               (when wasm?
                 (let [sqlite-install-dir-wasm (fs/absolutize (fs/path target-dir "sqlite-install-wasm"))
                       zlib-install-dir-wasm (fs/absolutize (fs/path target-dir "zlib-install-wasm"))
                       libtiff-install-dir-wasm (fs/absolutize (fs/path target-dir "libtiff-install-wasm"))
                       sqlite-install-dir-wasm-st (fs/absolutize (fs/path target-dir "sqlite-install-wasm-st"))
                       zlib-install-dir-wasm-st (fs/absolutize (fs/path target-dir "zlib-install-wasm-st"))
                       libtiff-install-dir-wasm-st (fs/absolutize (fs/path target-dir "libtiff-install-wasm-st"))
                       dest-resources "resources"
                       dest-resources-wasm (fs/path dest-resources "wasm")
                       dest-js-src "src/cljc/net/willcohen/proj"
                       proj-build-dir-wasm (fs/path target-dir proj-dir "proj-build-wasm")
                       proj-build-dir-wasm-st (fs/path target-dir proj-dir "proj-build-wasm-st")]

                   (println "--> Starting WASM build...")
                   (fs/create-dirs dest-resources-wasm)
                   (fs/create-dirs dest-js-src)

                   ;; One single-threaded WASM build serves the JS handler
                   ;; (Node + browser) and GraalVM/JVM. There is no pthreads
                   ;; build: the network path uses host callbacks registered
                   ;; through addFunction, so ENABLE_EMSCRIPTEN_FETCH, the only
                   ;; reason for -pthread, has no use. pthreads also
                   ;; hung `node --test` at worker teardown and forced
                   ;; COOP/COEP in the browser.
                   ;; This guard is output existence, so nothing else invalidates
                   ;; it: a changed compiler flag or a new PROJ version leaves
                   ;; the old wasm in place. Say so instead of exiting 0 on a
                   ;; stale artifact.
                   (if (fs/exists? (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js"))
                     (println "Reusing the existing single-threaded WASM build."
                              "Run `bb clean --wasm` first to pick up changed"
                              "build flags or C sources.")
                     (do
                       (println "Building single-threaded WASM dependencies...")
                       (build-sqlite {:type :wasm :install-dir sqlite-install-dir-wasm-st :cc "emcc" :pthreads? false :debug? debug?})
                       (build-zlib {:type :wasm :install-dir zlib-install-dir-wasm-st :cc "emcc" :pthreads? false :debug? debug?})
                       (build-libtiff {:type :wasm :install-dir libtiff-install-dir-wasm-st :zlib-install-dir zlib-install-dir-wasm-st
                                       :cc "emcc" :cxx "em++" :host-flag "--host=wasm32"
                                       :is-darwin? (= host-os :darwin) :is-linux? (= host-os :linux) :pthreads? false :debug? debug?})
                       (build-proj {:type :wasm :library-dir "wasm" :cc "emcc" :cxx "em++"
                                    :is-darwin? (= host-os :darwin) :is-windows? false
                                    :sqlite-install-dir sqlite-install-dir-wasm-st :zlib-install-dir zlib-install-dir-wasm-st
                                    :libtiff-install-dir libtiff-install-dir-wasm-st :pthreads? false :debug? debug?})))

                   ;; The emcc build emits proj-emscripten-st.js, which names
                   ;; proj-emscripten-st.wasm internally. Consumers load the
                   ;; pair as proj-emscripten.{js,wasm}, and emscripten's Node
                   ;; loader obeys the internal name, so patch it before
                   ;; staging.
                   (when (fs/exists? (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js"))
                     (println "Deploying single-threaded WASM to src/cljc + resources/wasm...")
                     (let [wasm-src (fs/path proj-build-dir-wasm-st "proj-emscripten-st.wasm")
                           map-src  (fs/path proj-build-dir-wasm-st "proj-emscripten-st.wasm.map")
                           patched-js (str/replace (slurp (str (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js")))
                                                   "proj-emscripten-st.wasm" "proj-emscripten.wasm")]
                       (doseq [dest [dest-js-src dest-resources-wasm]]
                         (spit (str (fs/path dest "proj-emscripten.js")) patched-js)
                         (fs/copy wasm-src (fs/path dest "proj-emscripten.wasm") {:replace-existing true})
                         ;; Stage the --debug source-map sidecar, or emscripten
                         ;; init hangs while it waits for the file.
                         (when (fs/exists? map-src)
                           (spit (str (fs/path dest "proj-emscripten.wasm.map"))
                                 (str/replace (slurp (str map-src)) "proj-emscripten-st.wasm" "proj-emscripten.wasm"))))
                       (fs/copy (fs/path proj-build-dir-wasm-st "proj.db") dest-resources {:replace-existing true})
                       (fs/copy (fs/path proj-build-dir-wasm-st "proj.ini") dest-resources {:replace-existing true})))

                   (when (fs/exists? (fs/path dest-js-src "proj-loader.mjs"))
                     (fs/copy (fs/path dest-js-src "proj-loader.mjs") dest-resources-wasm {:replace-existing true}))))

               (when (or (:cross opts) (:cross-platform opts))
                 (let [default-platforms ["linux/amd64" "linux/aarch64" "windows/amd64"]
                       target-platforms (if-let [p (:cross-platform opts)] [p] default-platforms)
                       route-artifacts
                       (fn [platform-tag artifacts-dir]
                         (let [dest-dir (fs/path "resources" platform-tag)
                               proj-build-dir (first (fs/glob artifacts-dir "proj-build-*/lib"))
                               lib-files (cond
                                           (str/includes? platform-tag "windows")
                                           (concat (when proj-build-dir (fs/glob proj-build-dir "*.dll"))
                                                   (fs/glob artifacts-dir "*.dll"))
                                           :else
                                           (concat (when proj-build-dir (fs/glob proj-build-dir "*.so"))
                                                   (fs/glob artifacts-dir "*.so")
                                                   (fs/glob artifacts-dir "*.dylib")))]
                           (fs/create-dirs dest-dir)
                           (doseq [lib-file lib-files]
                             (let [filename (fs/file-name lib-file)
                                   ;; Rename each PROJ DLL variant to libproj.dll. clj-native
                                   ;; extracts the resource <os>-<arch>/<lib-basename><suffix>,
                                   ;; and native.clj passes :lib-basename "libproj".
                                   target-name (if (and (str/includes? platform-tag "windows")
                                                        (re-matches (re-pattern ".*proj.*\\.dll") filename))
                                                 "libproj.dll"
                                                 filename)]
                               (println "Copying" (str lib-file) "to" (str (fs/path dest-dir target-name)))
                               (fs/copy lib-file (fs/path dest-dir target-name) {:replace-existing true})))
                           (when (fs/exists? (fs/path artifacts-dir "proj.db"))
                             (fs/copy (fs/path artifacts-dir "proj.db")
                                      (fs/path "resources" "proj.db") {:replace-existing true}))
                           (when (fs/exists? (fs/path artifacts-dir "proj.ini"))
                             (fs/copy (fs/path artifacts-dir "proj.ini")
                                      (fs/path "resources" "proj.ini") {:replace-existing true}))))]
                   (nb/cross-compile-in-container
                    {:platforms target-platforms
                     :image-tag "clj-proj-build"
                     :target "native-build"
                     :extract-paths ["/build/resources/$PLATFORM_TAG/."
                                     "/build/resources/proj.db"
                                     "/build/resources/proj.ini"]
                     :mounts (when (:local-proj opts)
                               [{:host-path (str (fs/canonicalize "vendor/PROJ"))
                                 :container-path "/build/vendor/PROJ"
                                 :read-only? true}])
                     :build-args (when (:local-proj opts)
                                   {"EXTRA_BB_ARGS" "--local-proj"})
                     :on-artifacts route-artifacts})))
               (println "Build task finished."))))}
  gen-handler
  {:doc "Regenerate src/cljc/net/willcohen/proj/proj-handler.mjs with clj-native's
gen-handler-source and resources/proj-handler-classification.edn. The
hand-written half lives in proj-handler-overrides.mjs."
   :requires ([net.willcohen.native.gen-handler :as gh])
   :task (do
           (println "Regenerating proj-handler.mjs from classification.edn...")
           (let [classification (edn/read-string
                                 (slurp "resources/proj-handler-classification.edn"))
                 out-path "src/cljc/net/willcohen/proj/proj-handler.mjs"
                 ;; classification.edn carries :destroy-fns, so fndefs is empty
                 ;; here. TODO: derive the list from fndefs metadata.
                 fndefs {}]
             (gh/write-handler! fndefs classification out-path)
             (println (str "Wrote " out-path))))}

  squint {:doc "Compile the ClojureScript with squint-cljs and bundle with esbuild."
          :depends [gen-handler]
          :task (do
                  (println "Compiling ClojureScript with squint...")
                  (let [proj-dir "src/cljc/net/willcohen/proj"
                        files ["fndefs.cljc" "macros.cljc" "wasm.cljc" "proj.cljc" "handler.cljc"]]

                    ;; dist/ is overwritten in place, never wiped. A wipe
                    ;; (fs/delete-tree) left a window in which a concurrent
                    ;; consumer of dist/proj.mjs got ERR_MODULE_NOT_FOUND. For
                    ;; a clean dist/, run `bb clean --target` first.
                    (fs/create-dirs (fs/path proj-dir "dist"))

                    (println "Installing npm dependencies...")
                    (tasks/shell {:dir proj-dir} "npm" "install")

                    (nb/ensure-consumer-squint-edn! proj-dir)

                    (doseq [file files]
                      (println (str "Compiling " file "..."))
                      (nb/squint-compile! proj-dir file))

                    (println "Squint compilation complete.")

                    (println "Running esbuild to bundle modules...")
                    (tasks/shell {:dir proj-dir} "npm" "run" "build")

                    (println "Copying WASM resources to dist...")
                    (let [dist-dir (fs/path proj-dir "dist")]
                      (fs/copy (fs/path "resources" "proj.db") (fs/path dist-dir "proj.db") {:replace-existing true})
                      (fs/copy (fs/path "resources" "proj.ini") (fs/path dist-dir "proj.ini") {:replace-existing true}))

                    (println "Bundle complete! Distribution in dist/")))}

  demo {:doc "Serve the browser demo at http://localhost:8080"
        :task (do
                (let [dist-dir (fs/path "src/cljc/net/willcohen/proj/dist")]
                  (when-not (and (fs/exists? (fs/path dist-dir "proj.mjs"))
                                 (fs/exists? (fs/path dist-dir "proj-handler.mjs")))
                    (println "Warning: dist folder missing files. Run 'bb squint' first.")))

                (let [link-path (fs/path "docs" "dist")
                      target-path (fs/path ".." "src" "cljc" "net" "willcohen" "proj" "dist")]
                  (when-not (fs/exists? link-path)
                    (println "Creating symlink docs/dist -> dist folder...")
                    (fs/create-sym-link link-path target-path)))

                (println "Starting demo server at http://localhost:8080")
                (println "Navigate to: http://localhost:8080/docs/")
                (println "Press Ctrl+C to stop")
                (tasks/shell "python3" "-m" "http.server" "8080"))}

  pom
  {:doc "Generate or update pom.xml."
   :task (do
           (println "Generating pom.xml...")
           (tasks/shell clj-cmd "-T:build" "pom")
           (println "pom.xml updated"))}

  jar
  {:doc "Build the project JAR."
   :depends [pom]
   :task (do
           (println "Building JAR file...")
           (tasks/shell clj-cmd "-T:build" "jar")
           (babashka.fs/copy "target/classes/META-INF/maven/net.willcohen/proj/pom.xml" "pom.xml" {:replace-existing true})
           (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))]
             (println (str "JAR built: target/proj-" version ".jar"))))}

  clojars-deploy
  {:doc "Deploy the JAR to Clojars."
   :depends [jar]
   :task (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))
               artifact (str "target/proj-" version ".jar")]
           (println (str "Deploying " artifact " to Clojars..."))
           (tasks/shell clj-cmd "-X:deploy" ":artifact" (pr-str artifact))
           (println "Deployed to Clojars"))}

  npm-publish
  {:doc "Publish the npm package."
   :depends [squint]
   :task (do
           (println "Publishing to npm...")
           (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "publish" "--tag" "alpha")
           (println "Published to npm"))}

  test:all
  {:doc "Run all test suites."
   :depends [test:ffi test:graal test:node test:playwright test:jar test:npm]}

  test:bench-node
  {:doc "Run the Node.js multi-worker benchmark (not part of test:all)."
   :task (do
           (println "Running Node.js multi-worker benchmark...")
           (tasks/shell "node" "--test" "test/js/benchmark.test.mjs"))}

  test:bench-browser
  {:doc "Run the Playwright multi-worker benchmark in a browser (not part of test:all)."
   :task (do
           (println "Running browser multi-worker benchmark...")
           (stage-browser-resources!)
           (tasks/shell {:dir "test/browser"} "npx" "playwright" "test" "tests/benchmark.spec.js"))}

  test:bench
  {:doc "Run all multi-worker benchmarks (Node.js and browser, not part of test:all)."
   :depends [test:bench-node test:bench-browser]}

  build:all
  {:doc "Build all artifacts (native, wasm, and cross-platform)."
   :task (do
           (println "Building native artifacts...")
           (tasks/shell "bb" "build" "--native")
           (println "Building WASM artifacts...")
           (tasks/shell "bb" "build" "--wasm")
           (println "Building cross-platform artifacts...")
           (tasks/shell "bb" "build" "--cross")
           (println "All builds complete!"))}

  test-run
  {:doc "Run all build and test tasks (except deploy)."
   :depends [clean pom build:all squint test:all jar]}

  quickdoc {:doc "Run quickdoc."
            :extra-deps {io.github.borkdude/quickdoc {:git/tag "v0.2.5", :git/sha "25784ca"}}
            :task (exec 'quickdoc.api/quickdoc)
            :exec-args {:git/branch "main"
                        :github/repo "https://github.com/willcohen/clj-proj"
                        :source-paths ["src/cljc/net/willcohen/proj/proj.cljc"]}}

  jar-contents {:doc "List all files in the JAR."
                :task (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))]
                        (println "\nJAR contents:")
                        (println "=============")
                        (tasks/shell "jar" "tf" (str "target/proj-" version ".jar"))
                        (println))}

  npm-contents {:doc "List the files that the npm package will contain."
                :task (do
                        (println "\nNPM package contents:")
                        (println "====================")
                        (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "pack" "--dry-run")
                        (println))}

  pre-deploy {:doc "Run all tests and show the package contents before deploy."
              :depends [test-run jar-contents npm-contents]
              :task (println "\nPre-deploy checks complete. Ready for deploy.")}

  deploy:dry-run
  {:doc "Show what deploy will do: version, git status, JAR contents, and npm dry-run."
   :depends [jar squint]
   :task (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))]
           (println (str "\n=== Deploy dry-run for " version " ===\n"))

           (println "npm auth:")
           (let [result (clojure.java.shell/sh "npm" "whoami")]
             (if (zero? (:exit result))
               (println (str "  Logged in as: " (str/trim (:out result))))
               (do (println "  NOT LOGGED IN. Run: npm login")
                   (System/exit 1))))
           (println)

           (println "Clojars auth:")
           (if (or (System/getenv "CLOJARS_USERNAME")
                   (.exists (java.io.File. (str (System/getProperty "user.home") "/.m2/settings.xml"))))
             (println "  Credentials found")
             (println "  WARNING: No CLOJARS_USERNAME env var or ~/.m2/settings.xml found"))
           (println)

           (println "Git status:")
           (tasks/shell "git" "status" "--short")
           (println)

           (println "Git log (last 3):")
           (tasks/shell {:extra-env {"GIT_PAGER" ""}} "git" "log" "--oneline" "-3")
           (println)

           (run 'jar-contents)
           (run 'npm-contents)

           (println "npm publish dry-run:")
           (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "publish" "--dry-run" "--tag" "alpha")
           (println)

           (println (str "Ready to deploy " version ". Run: bb deploy")))}

  deploy {:doc "Tag, push, and deploy to Clojars and npm. Run after you commit the release changes."
          :task (let [version (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj")))
                      npm-pkg "proj-wasm"
                      tag version]
                  (println (str "Deploying " version "..."))
                  (println)

                  (let [status (:out (clojure.java.shell/sh "git" "status" "--porcelain"))]
                    (when (seq (str/trim status))
                      (println "ERROR: Uncommitted changes. Commit first.")
                      (System/exit 1)))

                  (println (str "Tagging " tag "..."))
                  (tasks/shell "git" "tag" tag)

                  (println "Pushing to origin...")
                  (tasks/shell "git" "push" "origin" "main" "--tags")

                  (println "Deploying to Clojars...")
                  (run 'clojars-deploy)

                  (println "Publishing to npm...")
                  (run 'npm-publish)

                  (println (str "Setting npm latest tag to " version "..."))
                  (tasks/shell "npm" "dist-tag" "add" (str npm-pkg "@" version) "latest")

                  (println)
                  (println (str "Deployed " version " to Clojars and npm.")))}

  version-bump {:doc "Bump the version in all files. Usage: bb version-bump <new-version>"
                :task (let [new-version (first *command-line-args*)]
                        (if (nil? new-version)
                          (do
                            (println "Usage: bb version-bump <new-version>")
                            (println "Example: bb version-bump 0.1.0-alpha5")
                            (System/exit 1))
                          (do
                            (println (str "Bumping version to " new-version "..."))
                            (println)
                            ;; build.clj is the authoritative version. Every
                            ;; other file is rewritten from the version it
                            ;; holds, so a non-alpha version bumps too.
                            (let [build-content (slurp "build.clj")
                                  old-version (second (re-find (re-pattern "def version \"([^\"]+)\"") build-content))]
                              (when-not old-version
                                (println "Could not read the current version from build.clj.")
                                (System/exit 1))
                              (spit "build.clj"
                                    (str/replace build-content
                                                 (str "def version \"" old-version "\"")
                                                 (str "def version \"" new-version "\"")))
                              (println (str "  build.clj: " old-version " -> " new-version))
                              (doseq [[path old-text new-text]
                                      [["src/cljc/net/willcohen/proj/package.json"
                                        (str "\"version\": \"" old-version "\"")
                                        (str "\"version\": \"" new-version "\"")]]]
                                (let [content (slurp path)]
                                  (if (str/includes? content old-text)
                                    (do (spit path (str/replace content old-text new-text))
                                        (println (str "  " path ": " old-version " -> " new-version)))
                                    (println (str "  " path ": no " old-version " reference found, skipped"))))))
                            (println)
                            (println "Version bump complete.")
                            (println)
                            (println "Update CHANGELOG.md manually:")
                            (println "  1. Move [Unreleased] items to new version section")
                            (println "  2. Add date to version heading")
                            (println "  3. Add link reference at bottom of file")
                            (println)
                            (println "Update docs/index.html manually after the npm publish:")
                            (println "  1. Point the proj-wasm importmap pin at the new version")
                            (println "  2. Align the importmap with the bundle: squint-cljs entries")
                            (println "     (see test/browser/cdn-style/index.html), worker-router")
                            (println "     0.0.2+ (its blob shim permits a CDN worker-bootstrap),")
                            (println "     comlink, and the current resource-tracker")
                            (println "  3. Update the How-it-works build notes if the toolchain moved"))))}}}
