{:paths ["scripts"]
 :deps {net.willcohen/proj {:local/root "."}
        net.willcohen/native {:mvn/version "0.0.1"}
        org.babashka/http-client {:mvn/version "0.4.22"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.tasks :as tasks]
             [babashka.cli :as cli]
             [clojure.java.io :as io]
             [babashka.http-client :as http]
             [clojure.string :as str]
             [clojure.edn :as edn]
             [clojure.java.shell :as shell]
             [net.willcohen.native.build :as nb])

  :init (do (def proj-source {:type :tag :ref "9.8.1"})
            (def sqlite-version-url "3510200")
            (def sqlite-year "2026")
            (def zlib-version "1.3.2")
            (def libtiff-version "4.7.1")
            (def path-sep (System/getProperty "path.separator"))
            (def clj-cmd (str (or (fs/which "clojure") (fs/which "clj") "clojure")))

            ;; The :graal wasm guest JIT-compiles only on GraalVM CE (libgraal).
            ;; On other JDKs, the guest runs interpreted and the fallback is silent.
            (defn graalvm-jdk? []
              (try (str/includes?
                    (let [{:keys [out err]} (shell/sh "java" "-version")] (str out err))
                    "GraalVM")
                   (catch Exception _ false)))
            (def dist-dir "src/cljc/net/willcohen/proj/dist")

            ;; The browser suites load proj.db, proj.ini and the wasm as
            ;; sibling files of test.html, not through a bundler.
            (defn stage-browser-resources! []
              (println "Copying PROJ resources to test/browser...")
              (doseq [[src f] [["resources" "proj.db"]
                               ["resources" "proj.ini"]
                               [dist-dir "proj-emscripten.wasm"]]]
                (fs/copy (fs/path src f) (fs/path "test/browser" f)
                         {:replace-existing true})))

            (defn warn-unless-graalvm! []
              (when-not (graalvm-jdk?)
                (binding [*out* *err*]
                  (println)
                  (println "! java is not GraalVM CE -- the :graal PROJ wasm guest will run")
                  (println "! INTERPRETED (much slower). This repo's flake pins GraalVM CE 25.")
                  (println "! Activate it before :graal JVM tasks:")
                  (println "!   direnv allow          # one-time. Each shell in the repo then uses it")
                  (println "!   (or add direnv to your shell, or: nix develop --command bb <task>)")
                  (println)))))

  download-sources
  {:doc "Download source archives for zlib, sqlite, libtiff, and PROJ into target/"
   :task (let [target-dir "target"
               archives [[(str "zlib-" zlib-version ".tar.gz")
                          (str "https://zlib.net/zlib-" zlib-version ".tar.gz")]
                         [(str "sqlite-autoconf-" sqlite-version-url ".tar.gz")
                          (str "https://sqlite.org/" sqlite-year "/sqlite-autoconf-" sqlite-version-url ".tar.gz")]
                         [(str "libtiff-v" libtiff-version ".tar.gz")
                          (str "https://gitlab.com/libtiff/libtiff/-/archive/v" libtiff-version "/libtiff-v" libtiff-version ".tar.gz")]
                         [(str (:ref proj-source) ".tar.gz")
                          (str "https://github.com/OSGeo/PROJ/archive/refs/tags/" (:ref proj-source) ".tar.gz")]]]
           (fs/create-dirs target-dir)
           (doseq [[filename url] archives]
             (nb/download-archive url (fs/path target-dir filename))))}

  download-ci-artifacts
  {:doc "Download native and WASM build artifacts from CI. Each artifact comes from the most recent run that made it. The gh CLI is necessary."
   :task (let [artifact-names ["source-archives"
                               "native-macos" "native-linux-amd64" "native-linux-aarch64" "native-windows-amd64"
                               "wasm-browser" "wasm-graal"]
               dest-map {"source-archives" "target"
                         "native-macos" "resources/darwin-aarch64"
                         "native-linux-amd64" "resources/linux-amd64"
                         "native-linux-aarch64" "resources/linux-aarch64"
                         "native-windows-amd64" "resources/windows-amd64"
                         "wasm-graal" "resources/wasm"
                         "wasm-browser" "."}]
           (println "Downloading latest CI artifacts...")
           (doseq [artifact-name artifact-names]
             (let [dest (get dest-map artifact-name)
                   tmp-dir (str (fs/create-temp-dir {:prefix (str "ci-" artifact-name "-")}))]
               (print (str "  " artifact-name " -> " dest " ... "))
               (flush)
               (let [result (tasks/shell {:continue true} "gh" "run" "download" "-n" artifact-name "-D" tmp-dir)]
                 (if (zero? (:exit result))
                   (do
                     (doseq [f (fs/glob tmp-dir "**")]
                       (when (fs/regular-file? f)
                         (let [rel (fs/relativize tmp-dir f)
                               target (fs/path dest (str rel))]
                           (fs/create-dirs (fs/parent target))
                           (fs/copy f target {:replace-existing true}))))
                     (fs/delete-tree tmp-dir)
                     (println "ok"))
                   (do
                     (fs/delete-tree tmp-dir)
                     (println "not found")))))))}

  proj:clone
  {:doc "Clone the OSGeo/PROJ repository for local development. Use --branch to select a branch. Use --update to pull the latest changes."
   :spec {:branch {:desc "Branch to clone (default: master)"
                   :coerce :string}
          :update {:desc "Update the existing clone instead of cloning fresh"
                   :alias :u}
          :help {:desc "Show this help message"
                 :alias :h}}
   :task
   (let [opts (cli/parse-opts *command-line-args* {:spec (:spec (tasks/current-task))})
         vendor-dir (fs/path "vendor")
         proj-dir (fs/path vendor-dir "PROJ")
         branch (or (:branch opts) "master")
         update? (:update opts)]

     (when (:help opts)
       (println "\nUsage: bb proj:clone [options]\n")
       (println "Clone OSGeo/PROJ repository for local development and testing.")
       (println "The repository will be cloned to vendor/PROJ (gitignored).\n")
       (println "Options:")
       (println (cli/format-opts {:spec (:spec (tasks/current-task))
                                 :order [:branch :update :help]}))
       (println "\nExamples:")
       (println "  bb proj:clone                Clone master branch")
       (println "  bb proj:clone --branch=dev   Clone dev branch")
       (println "  bb proj:clone --update       Pull latest from current branch")
       (System/exit 0))

     (fs/create-dirs vendor-dir)

     (if update?
       (if (fs/exists? proj-dir)
         (do
           (println (str "Updating existing PROJ clone in " proj-dir "..."))
           (tasks/shell {:dir (str proj-dir)} "git" "fetch" "origin")
           (tasks/shell {:dir (str proj-dir)} "git" "pull" "origin" "HEAD")
           (println "PROJ repository updated successfully!"))
         (do
           (println (str "Error: No existing PROJ clone found at " proj-dir))
           (println "Run without --update to clone fresh, or check the path.")
           (System/exit 1)))

       (do
         (when (fs/exists? proj-dir)
           (println (str "Removing existing PROJ directory at " proj-dir "..."))
           (fs/delete-tree proj-dir))

         (println (str "Cloning OSGeo/PROJ (branch: " branch ") to " proj-dir "..."))
         (tasks/shell {:dir (str vendor-dir)}
                      "git" "clone"
                      "--branch" branch
                      "https://github.com/OSGeo/PROJ.git"
                      "PROJ")

         (println "PROJ repository cloned successfully!")
         (println (str "You can now make changes to " proj-dir " and use --local-proj with build tasks.")))))}

  kondo:fndefs
  {:doc "Regenerate the clj-kondo hook copy of fndefs from src/cljc/.../fndefs.cljc. Pass --check to do a check instead of a write."
   :requires ([kondo-fndefs])
   :task (apply kondo-fndefs/-main *command-line-args*)}

  lint:deps
  {:doc "Index the Clojure classpath into .clj-kondo/.cache-cli so clj-kondo resolves dependency vars. Run again after a dependency version bump."
   ;; clj-kondo resolves library vars only through this cache. The cache is
   ;; not in git, so a new clone reports each dependency var as "Unresolved
   ;; var". Only --dependencies fills the cache. It ignores --copy-configs,
   ;; so the config import is its own pass: .clj-kondo/config.edn needs
   ;; hooks.native.generated out of net.willcohen/native, and without it a
   ;; fresh clone fails the lint with two hook-load errors.
   ;;
   ;; The cache directory is .clj-kondo/.cache-cli, not the default
   ;; .clj-kondo/.cache. clojure-lsp writes the default one, and a library
   ;; hook file that declares a library namespace (dtype-next, for
   ;; tech.v3.tensor) lands there as a stub that hides the real vars.
   :task (let [cp (str/trim (:out (shell/sh clj-cmd "-Spath")))]
           (tasks/shell "clj-kondo" "--lint" cp "--copy-configs" "--skip-lint"
                        "--cache-dir" ".clj-kondo/.cache-cli")
           (tasks/shell "clj-kondo" "--lint" cp "--dependencies" "--parallel"
                        "--cache-dir" ".clj-kondo/.cache-cli"))}

  lint
  {:doc "Run clj-kondo on src and test with this project's exported hooks."
   :requires ([kondo-fndefs])
   :task (do (when-not (and (fs/exists? ".clj-kondo/.cache-cli")
                            (fs/exists? ".clj-kondo/net.willcohen/native"))
               (println "No clj-kondo dependency cache or imported configs. Indexing the classpath once (see lint:deps).")
               (tasks/run 'lint:deps))
             (kondo-fndefs/-main "--check")
             (tasks/shell "clj-kondo" "--lint" "src" "test"
                          "--cache-dir" ".clj-kondo/.cache-cli"))}

  clean
  {:doc "Delete generated artifacts. Use flags to select targets (--native, --wasm, --cross, --resources, --target). With no flags, delete all."
   ;; CAUTION: no flags means --all, which also deletes resources/proj.db,
   ;; resources/proj.ini, resources/grids, and resources/wasm. Only
   ;; `bb build --wasm` writes those files again, so `bb test:node` after a
   ;; bare `bb clean` fails on resources/proj.db. Use `bb clean --target`
   ;; to keep the resources tree.
   :spec {:native {:desc "Clean native host artifacts."}
          :wasm {:desc "Clean WASM artifacts."}
          :cross {:desc "Clean all cross-compiled artifacts."}
          :cross-platform {:desc "Clean a specific cross-platform target (for example linux/amd64)."
                           :coerce :string}
          :resources {:desc "Clean shared resources: proj.db, proj.ini, and downloaded grids."}
          :target {:desc "Clean only the target/ directory and keep resources/"}
          :all {:desc "Clean everything (default if no flags are given)."}
          :help {:desc "Show this help message"
                 :alias :h}}
   :task
   (let [opts (cli/parse-opts *command-line-args* {:spec (:spec (tasks/current-task))})]
     (when (:help opts)
       (println "\nUsage: bb clean [options]\n")
       (println "Options:")
       (println (cli/format-opts {:spec (:spec (tasks/current-task))
                                 :order [:native :wasm :cross :cross-platform
                                         :resources :target :all :help]}))
       (System/exit 0))

     (let [all? (or (:all opts) (empty? (dissoc opts :spec)))
           native? (or all? (:native opts))
           wasm? (or all? (:wasm opts))
           cross? (or all? (:cross opts) (:cross-platform opts))
           resources? (or all? (:resources opts))
           target-only? (:target opts)
           proj-dir (case (:type proj-source)
                      :tag (str "PROJ-" (:ref proj-source))
                      :sha "PROJ-git")

           delete-if-exists (fn [path]
                              (when (fs/exists? path)
                                (println "Deleting" (str path))
                                (fs/delete-tree path)))

           clean-target (fn [target-suffix]
                          (delete-if-exists (fs/path "target" (str "sqlite-install-" target-suffix)))
                          (delete-if-exists (fs/path "target" (str "zlib-install-" target-suffix)))
                          (delete-if-exists (fs/path "target" (str "libtiff-install-" target-suffix)))
                          (delete-if-exists (fs/path "target" proj-dir (str "proj-build-" target-suffix)))
                          (delete-if-exists (fs/path "target" "PROJ-local" (str "proj-build-" target-suffix)))
                          (delete-if-exists (fs/path "resources" target-suffix)))]

       (when native?
         (println "\nCleaning native host artifacts...")
         (let [host-os (let [os-name (System/getProperty "os.name")]
                         (cond
                           (re-find (re-pattern "(?i)mac|darwin") os-name) :darwin
                           (re-find (re-pattern "(?i)linux") os-name) :linux
                           :else :unknown))
               host-arch (let [os-arch (System/getProperty "os.arch")]
                           (cond
                             (re-find (re-pattern "(?i)aarch64|arm64") os-arch) :aarch64
                             (re-find (re-pattern "(?i)amd64|x86_64") os-arch) :amd64
                             :else :unknown))
               library-dir (str (name host-os) "-" (name host-arch))]
           (clean-target library-dir)))

       (when wasm?
         (println "\nCleaning WASM artifacts...")
         (clean-target "wasm")
         (clean-target "wasm-st")
         (doseq [f ["proj-emscripten.js" "proj-emscripten.wasm"
                    "proj-emscripten.wasm.map"]]
           (delete-if-exists (fs/path "src/cljc/net/willcohen/proj" f)))
         (doseq [f ["proj-emscripten.js" "proj-emscripten.wasm" "proj-loader.mjs"]]
           (delete-if-exists (fs/path "resources" "wasm" f)))
         ;; bb squint copies wasm into dist/ and never deletes. Without this
         ;; step, a release rebuild keeps a stale --debug wasm in dist/.
         (doseq [f ["proj-emscripten.js" "proj-emscripten.wasm" "proj-emscripten.wasm.map"]]
           (delete-if-exists (fs/path "src/cljc/net/willcohen/proj/dist" f))))

       (when cross?
         (println "\nCleaning cross-compiled artifacts...")
         (let [default-platforms ["linux/amd64" "linux/aarch64" "windows/amd64"]
               target-platforms (if-let [p (:cross-platform opts)] [p] default-platforms)]
           (doseq [platform target-platforms]
             (clean-target (str/replace platform "/" "-")))))

       (when resources?
         (println "\nCleaning shared resources...")
         (delete-if-exists (fs/path "resources" "proj.db"))
         (delete-if-exists (fs/path "resources" "proj.ini"))
         (delete-if-exists (fs/path "resources" "grids"))
         (delete-if-exists (fs/path "src" "js" "proj-emscripten" "src" "grids")))

       (when target-only?
         (println "\nCleaning target/ directory only...")
         (delete-if-exists "target"))

       (when all?
         (delete-if-exists "target"))

       (println "\nClean task finished.")))}

  dev
  {:doc "Run a local nREPL server for development, the same as 'clj -M:dev/repl'."
   :task (let [deps-map {:deps {'io.github.seancorfield/dot-clojure
                                {:git/tag "v1.3.0"
                                 :git/sha "98631b1"}}}
               deps-str (pr-str deps-map)]
           (println "Starting JVM nREPL server with clj...")
           (tasks/shell "clj" "-Sdeps" deps-str "-J-XX:+UnlockExperimentalVMOptions" "-J-XX:+EnableJVMCI" "-J--enable-native-access=ALL-UNNAMED" "-M" "-m" "org.corfield.dev.repl" "--port" "7888"))}

  nrepl
  {:doc "Run a plain nREPL server for Clojure MCP."
   :task (let [deps-map {:deps {'djblue/portal {:mvn/version "0.59.1"}
                                'nrepl/nrepl {:mvn/version "1.5.1"}}}
               deps-str (pr-str deps-map)]
           (println "Starting nREPL on port 7888")
           (tasks/shell "clj" "-Sdeps" deps-str "-J-XX:+UnlockExperimentalVMOptions" "-J-XX:+EnableJVMCI" "-J--enable-native-access=ALL-UNNAMED" "-J-Djdk.attach.allowAttachSelf" "-M" "-m" "nrepl.cmdline" "--port" "7888"))}

  compile-java-tests {:doc "Compile the Java test sources."
                      :task (do
                              (println "Compiling Java sources and tests...")
                              (fs/create-dirs "target/test-classes")
                              (tasks/shell "javac" "--release" "25"
                                           "-cp" (str "src/clj" path-sep "src/cljc" path-sep "resources" path-sep
                                                      (str/join path-sep (map str (fs/glob "." "**/*.jar")))
                                                      path-sep
                                                      (-> (tasks/shell {:out :string} clj-cmd "-Spath")
                                                          :out
                                                          str/trim))
                                           "-d" "target/test-classes"
                                           "src/java/net/willcohen/proj/PROJ.java")
                              (tasks/shell "javac" "--release" "25"
                                           "-cp" (str "target/test-classes" path-sep
                                                      (-> (tasks/shell {:out :string} clj-cmd "-Spath")
                                                          :out
                                                          str/trim))
                                           "-d" "target/test-classes"
                                           "test/java/net/willcohen/proj/PROJTest.java")
                              (println "Java compilation complete."))}

  test:java-ffi {:doc "Run the Java API tests with the FFI backend."
                 :depends [compile-java-tests]
                 :task (do
                         (println "Running Java API tests (FFI)...")
                         (tasks/shell "java"
                                      "-XX:+UnlockExperimentalVMOptions"
                                      "-XX:+EnableJVMCI"
                                      "--enable-native-access=ALL-UNNAMED"
                                      "-Dpolyglot.engine.WarnInterpreterOnly=false"
                                      "-cp" (str "target/test-classes" path-sep "src/clj" path-sep "src/cljc" path-sep "resources" path-sep
                                                 (-> (tasks/shell {:out :string} clj-cmd "-Spath")
                                                     :out
                                                     str/trim))
                                      "net.willcohen.proj.PROJTest"))}

  test:java-graal {:doc "Run the Java API tests with the GraalVM backend."
                   :depends [compile-java-tests]
                   :task (do
                           (warn-unless-graalvm!)
                           (println "Running Java API tests (GraalVM)...")
                           (tasks/shell "java"
                                        "-XX:+UnlockExperimentalVMOptions"
                                        "-XX:+EnableJVMCI"
                                        "-Dpolyglot.engine.WarnInterpreterOnly=false"
                                        "-cp" (str "target/test-classes" path-sep "src/clj" path-sep "src/cljc" path-sep "resources" path-sep
                                                   (-> (tasks/shell {:out :string} clj-cmd "-Spath")
                                                       :out
                                                       str/trim))
                                        "net.willcohen.proj.PROJTest"
                                        "--graal"))}

  test:clj-ffi {:doc "Run the Clojure tests for the FFI implementation. Java tests are not included."
                :task (do
                        (println "Running Clojure FFI tests...")
                        (tasks/shell clj-cmd
                                     "-J-Dnet.willcohen.proj.proj-test.implementation=ffi"
                                     "-J-XX:+UnlockExperimentalVMOptions"
                                     "-J-XX:+EnableJVMCI"
                                     "-J-Dpolyglot.engine.WarnInterpreterOnly=false"
                                     "-M:test"))}

  test:ffi {:doc "Run the Clojure and Java tests for the FFI implementation."
            :depends [test:clj-ffi test:java-ffi]
            :task (println "All FFI tests complete.")}

  test:clojure-graal {:doc "Run the Clojure tests for the GraalVM implementation."
                      :task (do
                              (warn-unless-graalvm!)
                              (println "Running Clojure GraalVM tests...")
                              ;; Without -XX:+EnableJVMCI, the polyglot context runs interpreted
                              ;; and the tests become approximately ten times slower.
                              (tasks/shell clj-cmd
                                           "-J-Dnet.willcohen.proj.proj-test.implementation=graal"
                                           "-J-XX:+UnlockExperimentalVMOptions"
                                           "-J-XX:+EnableJVMCI"
                                           "-J-Dpolyglot.engine.WarnInterpreterOnly=false"
                                           "-M:test"))}

  test:graal {:doc "Run the Clojure and Java tests for the GraalVM implementation."
              :task (let [java-result (do (println "\n=== Running Java GraalVM tests ===\n")
                                          (try (run 'test:java-graal) :passed
                                               (catch Exception e (println "Java GraalVM error:" (.getMessage e)) :failed)))
                          clj-result (do (println "\n=== Running Clojure GraalVM tests ===\n")
                                         (try (run 'test:clojure-graal) :passed
                                              (catch Exception e (println "Clojure GraalVM error:" (.getMessage e)) :failed)))]
                      (println "\n=== GraalVM Test Summary ===")
                      (println "Java tests:" (name java-result))
                      (println "Clojure tests:" (name clj-result))
                      (when (or (= java-result :failed) (= clj-result :failed))
                        (throw (ex-info "GraalVM tests failed" {:java java-result :clojure clj-result}))))}

  test:node {:doc "Run the Node.js test suite for proj-wasm. An alias for `bb test:cljs`.
The cljs.test suites under test/cljc are authoritative. test/js holds only
benchmark.test.mjs, which `bb test:bench-node` runs."
             :depends [test:cljs]}

  stage:clj-native-test-deps
  {:doc "Copy clj-native helper .mjs files into test/cljc/dist/ so the
cljs.test mirrors import them by relative path. A bare
`clj-native/test-runner` import would resolve into the nested clj-native
under test/cljc/node_modules/proj-wasm/node_modules/, which ships its
own squint-cljs. That gives two squint-cljs ESM instances with two
cljs.test registries, and `t/run-tests` reads only the topmost one. The
staged copies still import 'squint-cljs/...' as bare specifiers, which
test/cljc/node_modules/ resolves uniformly.
:native-src is required here: the Clojars jar carries no .mjs, so the
staged copies come from the installed ffi-wasm npm package."
   :task (nb/stage-test-deps!
          {:native-src "src/cljc/net/willcohen/proj/node_modules/ffi-wasm/src/cljc/net/willcohen/native"})}

  squint:test:lru
  {:doc "Compile test/cljc/lru_test.cljc -> lru_test.mjs.
The suite examines the bounded-LRU helpers."
   :depends [squint stage:clj-native-test-deps]
   :task (nb/squint-compile! "test/cljc" "lru_test.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  squint:test:proj-handler
  {:doc "Compile test/cljc/proj_handler_test.cljc -> proj_handler_test.mjs.
The suite examines the generated handler's import shape, init, and ccall
surface."
   :depends [squint stage:clj-native-test-deps]
   :task (nb/squint-compile! "test/cljc" "proj_handler_test.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  squint:test:resource-tracking
  {:doc "Compile test/cljc/resource_tracking_test.cljc -> resource_tracking_test.mjs.
The suite examines disposers, GC pressure, and the shutdown drain."
   :depends [squint stage:clj-native-test-deps]
   :task (nb/squint-compile! "test/cljc" "resource_tracking_test.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  squint:test:benchmark
  {:doc "Compile test/cljc/benchmark_test.cljc -> benchmark_test.mjs.
STUB: the scaffold exists so test:cljs can address every file by name.
Performance numbers stay in test/js/benchmark.test.mjs."
   :depends [squint]
   :task (nb/squint-compile! "test/cljc" "benchmark_test.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  squint:test:proj-test-macros
  {:doc "Compile test/cljc/net/willcohen/proj/proj_test_macros.cljc -> .mjs.

The file holds the cljs-side macros (with-each-implementation,
with-test-context) that proj_test.cljc requires. Squint expands them at
compile time through SCI but still emits a runtime import of
'./proj_test_macros.mjs' from proj_test.mjs, so the almost empty
compiled .mjs must exist on disk for node."
   :depends [squint]
   :task (nb/squint-compile! "test/cljc" "net/willcohen/proj/proj_test_macros.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  squint:test:proj
  {:doc "Compile the dual-runtime test file
test/cljc/net/willcohen/proj/proj_test.cljc -> proj_test.mjs.
The same file runs on the JVM through `bb test:ffi` and under node
through `bb test:cljs`."
   :depends [squint squint:test:proj-test-macros stage:clj-native-test-deps]
   :task (nb/squint-compile! "test/cljc" "net/willcohen/proj/proj_test.cljc"
                             {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"})}

  build:js:test
  {:doc "Compile all cljs.test mirrors before `bb test:cljs` and `bb test:cljs:wip`."
   :depends [squint:test:lru squint:test:proj-handler
             squint:test:resource-tracking squint:test:benchmark squint:test:proj]}

  test:cljs
  {:doc "Run the cljs.test suites:
  - lru_test.cljc                  (bounded-LRU helpers)
  - proj_handler_test.cljc         (generated handler surface)
  - net/willcohen/proj/proj_test.cljc
                                   (the PROJ API)
  - resource_tracking_test.cljc    (disposers, GC pressure, shutdown drain)

benchmark_test.cljc stays under `bb test:cljs:wip`. Performance numbers
come from test/js/benchmark.test.mjs (`bb test:bench-node`), because
cljs.test is not a good host for timing measurements. The
resource_tracking_test FR-fires case skips itself when global.gc is not
available, so a plain node run stays green."
   :depends [squint build:js:test]
   :task (do
           (println "Installing test/cljc node deps...")
           (tasks/shell {:dir "test/cljc"} "npm" "install")
           (tasks/shell "node" "test/cljc/lru_test.mjs")
           (tasks/shell "node" "test/cljc/proj_handler_test.mjs")
           ;; proj_test imports proj-wasm through its file: symlink, which
           ;; pulls proj's node_modules/squint-cljs into the module graph as a
           ;; second squint ESM instance. squint 0.14 makes Atom and protocol
           ;; identity per-instance, so a proj-created Atom fails IDeref in a
           ;; test body. Fix: run with --preserve-symlinks and stash the
           ;; proj-side squint copy, so the bundle resolves the single
           ;; test-side copy. TEMPORARY: when ffi-wasm and worker-router
           ;; publish as versioned deps, npm dedupes squint and this
           ;; workaround becomes unnecessary. lru_test and proj_handler_test
           ;; do not cross this boundary. resource_tracking_test crosses it
           ;; but runs plain (see below).
           (let [proj-squint (fs/path "src/cljc/net/willcohen/proj/node_modules/squint-cljs")
                 stash       (fs/path "src/cljc/net/willcohen/proj/node_modules/.squint-cljs.testbak")]
             ;; Recover from a crashed previous run.
             (when (fs/exists? stash)
               (if (fs/exists? proj-squint) (fs/delete-tree stash) (fs/move stash proj-squint)))
             (try
               (when (fs/exists? proj-squint) (fs/move proj-squint stash))
               (tasks/shell "node" "--preserve-symlinks" "--preserve-symlinks-main"
                            "test/cljc/net/willcohen/proj/proj_test.mjs")
               (finally
                 (when (fs/exists? stash)
                   (when (fs/exists? proj-squint) (fs/delete-tree proj-squint))
                   (fs/move stash proj-squint)))))
           ;; resource_tracking_test imports dist/proj.mjs by real path, so it
           ;; runs without --preserve-symlinks. That flag makes the real-path
           ;; import fail to resolve squint-cljs. Its cross-instance use stays
           ;; inside its own squint instance, so the dual-instance boundary
           ;; does not apply here.
           (tasks/shell "node" "test/cljc/resource_tracking_test.mjs"))}

  test:cljs:wip
  {:doc "Run the cljs.test scaffolds, files whose bodies are TODO stubs.
They fail until the port completes, but the run still initializes
proj/dist and finds infrastructure breakage early. Only
benchmark_test.cljc lives here, and its one placeholder deftest passes.
`:continue true` lets the chain continue after a TODO failure."
   :depends [squint build:js:test]
   :task (do
           (println "Installing test/cljc node deps...")
           (tasks/shell {:dir "test/cljc"} "npm" "install")
           (tasks/shell {:continue true} "node" "test/cljc/benchmark_test.mjs"))}

