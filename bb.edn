  check:squint-pin
  {:doc "Make sure that the browser importmaps use the squint-cljs version that package.json pins."
   ;; The browser test pages load squint-cljs from a CDN at an explicit
   ;; version. The bundle is compiled against the package.json pin. No
   ;; other check compares the two versions.
   :task (let [pin-re (re-pattern "\"squint-cljs\":\\s*\"\\^?([0-9][^\"]*)\"")
               map-re (re-pattern "squint-cljs@([0-9][^/\"]*)")
               pinned (second (re-find pin-re (slurp "src/cljc/net/willcohen/proj/package.json")))
               pages  ["test/browser/test.html" "test/browser/cdn-style/index.html"]
               wrong  (for [page pages
                            v (map second (re-seq map-re (slurp page)))
                            :when (not= v pinned)]
                        [page v])]
           (when-not pinned
             (throw (ex-info "No squint-cljs version found in package.json" {})))
           (if (seq wrong)
             (do (binding [*out* *err*]
                   (println (str "squint-cljs is pinned at " pinned
                                 ", but the browser importmaps use:"))
                   (doseq [[page v] wrong] (println (str "  " page " -> " v))))
                 (System/exit 1))
             (println (str "squint-cljs importmap pin matches package.json: " pinned))))}

  test:playwright {:doc "Run the browser integration tests with Playwright."
                   :depends [squint check:squint-pin]
                   :task (do
                           (stage-browser-resources!)
                           (println "Setting up cdn-style test directory...")
                           (fs/create-dirs "test/browser/cdn-style/dist")
                           ;; The cdn-style test has no npm install. Each module
                           ;; that proj.mjs or the handler resolves at runtime,
                           ;; through sibling-relative imports or importmap
                           ;; entries, must ship in its dist/ copy. That
                           ;; includes resource-tracker, so the test stays off
                           ;; the network and on the installed version.
                           (doseq [f ["proj.mjs" "proj.mjs.map" "proj-emscripten.wasm"
                                      "proj.db" "proj.ini" "proj-emscripten.js"
                                      "proj-handler.mjs" "proj-handler-overrides.mjs"
                                      "fetch_worker.mjs" "worker-bootstrap.mjs"
                                      "worker-router.mjs" "comlink.mjs"
                                      "resource-tracker.mjs" "handler-runtime.mjs"]]
                             (fs/copy (fs/path dist-dir f)
                                      (fs/path "test/browser/cdn-style/dist" f)
                                      {:replace-existing true}))
                           (println "Installing Playwright dependencies...")
                           (tasks/shell {:dir "test/browser"} "npm" "install")
                           (println "Installing Playwright browsers...")
                           ;; Name the browsers that playwright.config.js
                           ;; declares. A bare `install` also fetches webkit and
                           ;; deletes builds that no registered installation
                           ;; references. The 1.61.1 @playwright/test pin
                           ;; matches worker-router and cg-app, so all three
                           ;; share one chromium build and a run downloads
                           ;; nothing.
                           (tasks/shell {:dir "test/browser"} "npx" "playwright" "install" "--with-deps" "chromium" "firefox")
                           (println "Running Playwright tests...")
                           (tasks/shell {:dir "test/browser"} "npm" "test"))}

