{:paths ["scripts"]
 :deps {net.willcohen/proj {:local/root "."}
        net.willcohen/native {:mvn/version "0.0.2"}
        org.babashka/http-client {:mvn/version "0.4.22"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.tasks :as tasks]
             [babashka.cli :as cli]
             [clojure.java.io :as io]
             [babashka.http-client :as http]
             [clojure.string :as str]
             [clojure.edn :as edn]
             [clojure.java.shell :as shell]
             [net.willcohen.native.build :as nb])

  :init (do (def proj-version "9.9.0")
            (def cross-platforms ["linux/amd64" "linux/aarch64" "linux/amd64-musl"
                                  "linux/aarch64-musl" "windows/amd64"])
            (def sqlite-version-url "3510200")
            (def sqlite-year "2026")
            (def zlib-version "1.3.2")
            (def libtiff-version "4.7.1")
            (def zlib-dir (str "zlib-" zlib-version))
            (def sqlite-dir (str "sqlite-autoconf-" sqlite-version-url))
            (def libtiff-dir (str "libtiff-v" libtiff-version))
            ;; Each entry is [archive url extracted-dir]. PROJ is last, so
            ;; --local-proj can drop it.
            (def source-archives
              [[(str zlib-dir ".tar.gz")
                (str "https://github.com/madler/zlib/releases/download/v" zlib-version "/" zlib-dir ".tar.gz")
                zlib-dir]
               [(str sqlite-dir ".tar.gz")
                (str "https://sqlite.org/" sqlite-year "/" sqlite-dir ".tar.gz")
                sqlite-dir]
               [(str libtiff-dir ".tar.gz")
                (str "https://gitlab.com/libtiff/libtiff/-/archive/v" libtiff-version "/" libtiff-dir ".tar.gz")
                libtiff-dir]
               [(str proj-version ".tar.gz")
                (str "https://github.com/OSGeo/PROJ/archive/refs/tags/" proj-version ".tar.gz")
                (str "PROJ-" proj-version)]])
            (def path-sep (System/getProperty "path.separator"))
            (def clj-cmd (str (or (fs/which "clojure") (fs/which "clj") "clojure")))
            (defn clj-classpath [] (str/trim (:out (tasks/shell {:out :string} clj-cmd "-Spath"))))
            (defn project-version []
              (second (re-find (re-pattern "def version \"([^\"]+)\"") (slurp "build.clj"))))
            (defn jar-file [] (str "target/proj-" (project-version) ".jar"))

            ;; The :graal wasm guest JIT-compiles only on GraalVM CE (libgraal).
            ;; On other JDKs, the guest runs interpreted and the fallback is silent.
            (defn graalvm-jdk? []
              (try (str/includes?
                    (let [{:keys [out err]} (shell/sh "java" "-version")] (str out err))
                    "GraalVM")
                   (catch Exception _ false)))
            (def dist-dir "src/cljc/net/willcohen/proj/dist")

            ;; The browser suites load proj.db, proj.ini and the wasm as
            ;; sibling files of test.html, not through a bundler.
            (defn stage-browser-resources! []
              (println "Copying PROJ resources to test/browser...")
              (doseq [[src f] [["resources" "proj.db"]
                               ["resources" "proj.ini"]
                               [dist-dir "proj-emscripten.wasm"]]]
                (fs/copy (fs/path src f) (fs/path "test/browser" f)
                         {:replace-existing true})))

            (defn warn-unless-graalvm! []
              (when-not (graalvm-jdk?)
                (binding [*out* *err*]
                  (println)
                  (println "! java is not GraalVM CE -- the :graal PROJ wasm guest will run")
                  (println "! INTERPRETED (much slower). This repo's flake pins GraalVM CE 25.")
                  (println "! Activate it before :graal JVM tasks:")
                  (println "!   direnv allow          # one-time. Each shell in the repo then uses it")
                  (println "!   (or add direnv to your shell, or: nix develop --command bb <task>)")
                  (println))))

            ;; Without -XX:+EnableJVMCI, the polyglot context runs interpreted
            ;; and the tests become approximately ten times slower.
            (defn clj-tests! [impl]
              (tasks/shell clj-cmd
                           (str "-J-Dnet.willcohen.proj.proj-test.implementation=" impl)
                           "-J-XX:+UnlockExperimentalVMOptions"
                           "-J-XX:+EnableJVMCI"
                           "-J-Dpolyglot.engine.WarnInterpreterOnly=false"
                           "-M:test"))

            (defn java-tests! [& args]
              (apply tasks/shell "java"
                     "-XX:+UnlockExperimentalVMOptions"
                     "-XX:+EnableJVMCI"
                     "--enable-native-access=ALL-UNNAMED"
                     "-Dpolyglot.engine.WarnInterpreterOnly=false"
                     "-cp" (str "target/test-classes" path-sep (clj-classpath))
                     "net.willcohen.proj.PROJTest"
                     args))

            (defn task-opts
              "Parse the args of the current task by its :spec. With --help,
               print the options in `order` and exit."
              [& order]
              (let [task (tasks/current-task)
                    opts (cli/parse-opts *command-line-args* {:spec (:spec task)})]
                (when (:help opts)
                  (println (str "\nUsage: bb " (:name task) " [options]\n"))
                  (println "Options:")
                  (println (cli/format-opts {:spec (:spec task) :order order}))
                  (System/exit 0))
                opts)))

  download-sources
  {:doc "Download source archives for zlib, sqlite, libtiff, and PROJ into target/"
   :task (doseq [[archive url] source-archives]
           (nb/download-archive url (fs/path "target" archive)))}

  download-ci-artifacts
  {:doc "Download native and WASM build artifacts from CI. Each artifact comes from the most recent run that made it. The gh CLI is necessary."
   :task (let [dest-map {"source-archives" "target"
                         "native-macos" "resources/darwin-aarch64"
                         "native-linux-amd64" "resources/linux-amd64"
                         "native-linux-aarch64" "resources/linux-aarch64"
                         "native-linux-amd64-musl" "resources/linux-amd64-musl"
                         "native-linux-aarch64-musl" "resources/linux-aarch64-musl"
                         "native-windows-amd64" "resources/windows-amd64"
                         "wasm-graal" "resources/wasm"
                         "wasm-browser" "."}]
           (println "Downloading latest CI artifacts...")
           (doseq [[artifact-name dest] dest-map]
             (let [tmp-dir (str (fs/create-temp-dir {:prefix (str "ci-" artifact-name "-")}))]
               (print (str "  " artifact-name " -> " dest " ... "))
               (flush)
               (let [ok? (zero? (:exit (tasks/shell {:continue true} "gh" "run" "download" "-n" artifact-name "-D" tmp-dir)))]
                 (when ok?
                   (doseq [f (fs/glob tmp-dir "**")]
                     (when (fs/regular-file? f)
                       (let [target (fs/path dest (str (fs/relativize tmp-dir f)))]
                         (fs/create-dirs (fs/parent target))
                         (fs/copy f target {:replace-existing true})))))
                 (fs/delete-tree tmp-dir)
                 (println (if ok? "ok" "not found"))))))}

  proj:clone
  {:doc "Clone the OSGeo/PROJ repository for local development. Use --branch to select a branch. Use --update to pull the latest changes."
   :spec {:branch {:desc "Branch to clone (default: master)"
                   :coerce :string}
          :update {:desc "Update the existing clone instead of cloning fresh"
                   :alias :u}
          :help {:desc "Show this help message"
                 :alias :h}}
   :task
   (let [opts (task-opts :branch :update :help)
         vendor-dir (fs/path "vendor")
         proj-dir (fs/path vendor-dir "PROJ")
         branch (or (:branch opts) "master")
         update? (:update opts)]

     (fs/create-dirs vendor-dir)

     (if update?
       (if (fs/exists? proj-dir)
         (do
           (println (str "Updating existing PROJ clone in " proj-dir "..."))
           (tasks/shell {:dir (str proj-dir)} "git" "fetch" "origin")
           (tasks/shell {:dir (str proj-dir)} "git" "pull" "origin" "HEAD")
           (println "PROJ repository updated successfully!"))
         (do
           (println (str "Error: No existing PROJ clone found at " proj-dir))
           (println "Run without --update to clone fresh, or check the path.")
           (System/exit 1)))

       (do
         (when (fs/exists? proj-dir)
           (println (str "Removing existing PROJ directory at " proj-dir "..."))
           (fs/delete-tree proj-dir))

         (println (str "Cloning OSGeo/PROJ (branch: " branch ") to " proj-dir "..."))
         (tasks/shell {:dir (str vendor-dir)}
                      "git" "clone"
                      "--branch" branch
                      "https://github.com/OSGeo/PROJ.git"
                      "PROJ")

         (println "PROJ repository cloned successfully!")
         (println (str "You can now make changes to " proj-dir " and use --local-proj with build tasks.")))))}

  kondo:fndefs
  {:doc "Regenerate the clj-kondo hook copy of fndefs from src/cljc/.../fndefs.cljc. Pass --check to do a check instead of a write."
   :requires ([kondo-fndefs])
   :task (apply kondo-fndefs/-main *command-line-args*)}

  lint:deps
  {:doc "Index the Clojure classpath into .clj-kondo/.cache-cli so clj-kondo resolves dependency vars. Run again after a dependency version bump."
   ;; --dependencies ignores --copy-configs, so the import of the
   ;; hooks.native.generated config is its own pass. Not the default .cache:
   ;; clojure-lsp writes there, and its stub of a hooked library ns
   ;; (dtype-next's tech.v3.tensor) hides the real vars.
   :task (let [cp (clj-classpath)]
           (tasks/shell "clj-kondo" "--lint" cp "--copy-configs" "--skip-lint"
                        "--cache-dir" ".clj-kondo/.cache-cli")
           (tasks/shell "clj-kondo" "--lint" cp "--dependencies" "--parallel"
                        "--cache-dir" ".clj-kondo/.cache-cli"))}

  lint
  {:doc "Run clj-kondo on src and test with this project's exported hooks."
   :requires ([kondo-fndefs])
   :task (do (when-not (and (fs/exists? ".clj-kondo/.cache-cli")
                            (fs/exists? ".clj-kondo/net.willcohen/native"))
               (println "No clj-kondo dependency cache or imported configs. Indexing the classpath once (see lint:deps).")
               (tasks/run 'lint:deps))
             (kondo-fndefs/-main "--check")
             (tasks/shell "clj-kondo" "--lint" "src" "test"
                          "--cache-dir" ".clj-kondo/.cache-cli"))}

  clean
  {:doc "Delete generated artifacts. Use flags to select targets (--native, --wasm, --cross, --resources, --target). With no flags, delete all."
   ;; No flags also deletes resources/proj.db, proj.ini and wasm/, which
   ;; only `bb build` writes again. `--target` keeps them.
   :spec {:native {:desc "Clean native host artifacts."}
          :wasm {:desc "Clean WASM artifacts."}
          :cross {:desc "Clean all cross-compiled artifacts."}
          :cross-platform {:desc "Clean a specific cross-platform target (for example linux/amd64)."
                           :coerce :string}
          :resources {:desc "Clean resources/proj.db, proj.ini and grids."}
          :target {:desc "Clean only the target/ directory and keep resources/"}
          :all {:desc "Clean everything (default if no flags are given)."}
          :help {:desc "Show this help message"
                 :alias :h}}
   :task
   (let [opts (task-opts :native :wasm :cross :cross-platform :resources :target :all :help)
         all? (or (:all opts) (empty? opts))
         native? (or all? (:native opts))
         wasm? (or all? (:wasm opts))
         cross? (or all? (:cross opts) (:cross-platform opts))
         resources? (or all? (:resources opts))
         target-only? (:target opts)
         proj-dir (str "PROJ-" proj-version)

         delete-if-exists (fn [path]
                            (when (fs/exists? path)
                              (println "Deleting" (str path))
                              (fs/delete-tree path)))

         clean-target (fn [target-suffix]
                        (delete-if-exists (fs/path "target" (str "sqlite-install-" target-suffix)))
                        (delete-if-exists (fs/path "target" (str "zlib-install-" target-suffix)))
                        (delete-if-exists (fs/path "target" (str "libtiff-install-" target-suffix)))
                        (delete-if-exists (fs/path "target" (str "zig-" target-suffix)))
                        (delete-if-exists (fs/path "target" proj-dir (str "proj-build-" target-suffix)))
                        (delete-if-exists (fs/path "target" "PROJ-local" (str "proj-build-" target-suffix)))
                        (delete-if-exists (fs/path "resources" target-suffix)))]

     (when native?
       (println "\nCleaning native host artifacts...")
       (let [{:keys [os arch]} (nb/detect-host-platform)]
         (clean-target (str (name os) "-" (name arch)))))

     (when wasm?
       (println "\nCleaning WASM artifacts...")
       (clean-target "wasm")
       (clean-target "wasm-st")
       ;; bb squint copies the wasm into dist/ and never deletes it. Without
       ;; this step, a release rebuild keeps a stale --debug wasm in dist/.
       (doseq [dir ["src/cljc/net/willcohen/proj" dist-dir]
               f ["proj-emscripten.js" "proj-emscripten.wasm" "proj-emscripten.wasm.map"]]
         (delete-if-exists (fs/path dir f))))

     (when cross?
       (println "\nCleaning cross-compiled artifacts...")
       (let [target-platforms (if-let [p (:cross-platform opts)] [p] cross-platforms)]
         (doseq [platform target-platforms]
           (clean-target (str/replace platform "/" "-")))))

     (when resources?
       (println "\nCleaning shared resources...")
       (delete-if-exists (fs/path "resources" "proj.db"))
       (delete-if-exists (fs/path "resources" "proj.ini"))
       (delete-if-exists (fs/path "resources" "grids")))

     (when target-only?
       (println "\nCleaning target/ directory only...")
       (delete-if-exists "target"))

     (when all?
       (delete-if-exists "target"))

     (println "\nClean task finished."))}

  dev
  {:doc "Run a local nREPL server for development, the same as 'clj -M:dev/repl'."
   :task (let [deps-map {:deps {'io.github.seancorfield/dot-clojure
                                {:git/tag "v1.3.0"
                                 :git/sha "98631b1"}}}
               deps-str (pr-str deps-map)]
           (println "Starting JVM nREPL server with clj...")
           (tasks/shell "clj" "-Sdeps" deps-str "-J-XX:+UnlockExperimentalVMOptions" "-J-XX:+EnableJVMCI" "-J--enable-native-access=ALL-UNNAMED" "-M" "-m" "org.corfield.dev.repl" "--port" "7888"))}

  nrepl
  {:doc "Run a plain nREPL server for Clojure MCP."
   :task (let [deps-map {:deps {'djblue/portal {:mvn/version "0.59.1"}
                                'nrepl/nrepl {:mvn/version "1.5.1"}}}
               deps-str (pr-str deps-map)]
           (println "Starting nREPL on port 7888")
           (tasks/shell "clj" "-Sdeps" deps-str "-J-XX:+UnlockExperimentalVMOptions" "-J-XX:+EnableJVMCI" "-J--enable-native-access=ALL-UNNAMED" "-J-Djdk.attach.allowAttachSelf" "-M" "-m" "nrepl.cmdline" "--port" "7888"))}

  compile-java-tests {:doc "Compile the Java test sources."
                      :task (do
                              (println "Compiling Java sources and tests...")
                              (fs/create-dirs "target/test-classes")
                              (tasks/shell "javac" "--release" "25"
                                           "-cp" (clj-classpath)
                                           "-d" "target/test-classes"
                                           "src/java/net/willcohen/proj/PROJ.java"
                                           "test/java/net/willcohen/proj/PROJTest.java")
                              (println "Java compilation complete."))}

  test:java-ffi {:doc "Run the Java API tests with the FFI backend."
                 :depends [compile-java-tests]
                 :task (do
                         (println "Running Java API tests (FFI)...")
                         (java-tests!))}

  test:java-graal {:doc "Run the Java API tests with the GraalVM backend."
                   :depends [compile-java-tests]
                   :task (do
                           (warn-unless-graalvm!)
                           (println "Running Java API tests (GraalVM)...")
                           (java-tests! "--graal"))}

  test:clj-ffi {:doc "Run the Clojure tests for the FFI implementation. Java tests are not included."
                :task (do
                        (println "Running Clojure FFI tests...")
                        (clj-tests! "ffi"))}

  test:ffi {:doc "Run the Clojure and Java tests for the FFI implementation."
            :depends [test:clj-ffi test:java-ffi]
            :task (println "All FFI tests complete.")}

  test:clojure-graal {:doc "Run the Clojure tests for the GraalVM implementation."
                      :task (do
                              (warn-unless-graalvm!)
                              (println "Running Clojure GraalVM tests...")
                              (clj-tests! "graal"))}

  test:graal {:doc "Run the Clojure and Java tests for the GraalVM implementation."
              :depends [test:java-graal test:clojure-graal]
              :task (println "All GraalVM tests complete.")}

  test:node {:doc "Run the Node.js suites (test:cljs)."
             :depends [test:cljs]}

  stage:clj-native-test-deps
  {:doc "Copy the clj-native test helpers from the installed ffi-wasm into test/cljc/dist/."
   ;; The Clojars jar has no .mjs.
   :task (nb/stage-test-deps!
          {:native-src "src/cljc/net/willcohen/proj/node_modules/ffi-wasm/src/cljc/net/willcohen/native"})}

  build:js:test
  {:doc "Compile the cljs.test suites in test/cljc."
   :depends [squint stage:clj-native-test-deps]
   ;; proj_test.mjs imports proj_test_macros.mjs at run time.
   :task (doseq [f ["proj_handler_test.cljc"
                    "resource_tracking_test.cljc"
                    "net/willcohen/proj/proj_test_macros.cljc"
                    "net/willcohen/proj/proj_test.cljc"]]
           (nb/squint-compile! "test/cljc" f
                               {:binary "../../src/cljc/net/willcohen/proj/node_modules/.bin/squint"}))}

  test:cljs
  {:doc "Run the cljs.test suites under node."
   :depends [squint build:js:test]
   :task (do
           (println "Installing test/cljc node deps...")
           (tasks/shell {:dir "test/cljc"} "npm" "install")
           (tasks/shell "node" "test/cljc/proj_handler_test.mjs")
           ;; proj-wasm is a file: dep, so its own node_modules/squint-cljs
           ;; would load as a second squint instance, and a proj-created Atom
           ;; would fail IDeref in a test body. Stash that copy and preserve
           ;; symlinks, so one squint-cljs loads.
           (let [proj-squint (fs/path "src/cljc/net/willcohen/proj/node_modules/squint-cljs")
                 stash       (fs/path "src/cljc/net/willcohen/proj/node_modules/.squint-cljs.testbak")]
             ;; Recover from a crashed previous run.
             (when (fs/exists? stash)
               (if (fs/exists? proj-squint) (fs/delete-tree stash) (fs/move stash proj-squint)))
             (try
               (when (fs/exists? proj-squint) (fs/move proj-squint stash))
               (tasks/shell "node" "--preserve-symlinks" "--preserve-symlinks-main"
                            "test/cljc/net/willcohen/proj/proj_test.mjs")
               (finally
                 (when (fs/exists? stash)
                   (when (fs/exists? proj-squint) (fs/delete-tree proj-squint))
                   (fs/move stash proj-squint)))))
           ;; resource_tracking_test imports dist/proj.mjs by real path, which
           ;; --preserve-symlinks breaks.
           (tasks/shell "node" "test/cljc/resource_tracking_test.mjs"))}

  test:npm {:doc "Run the test suite of the built npm package."
            :depends [squint]
            :requires ([cheshire.core :as json])
            :task (do
                    (let [packed (-> (tasks/shell {:dir "src/cljc/net/willcohen/proj" :out :string}
                                                  "npm" "pack" "--dry-run" "--json")
                                     :out json/parse-string first (get "files"))
                          paths (set (map (fn [f] (get f "path")) packed))
                          ;; ffi-wasm, worker-router, comlink and resource-tracker
                          ;; resolve from node_modules or the page importmap.
                          want #{"LICENSE" "README.md" "package.json"
                                 "dist/THIRD-PARTY-NOTICES.md" "dist/proj.mjs"
                                 "dist/proj-handler.mjs" "dist/proj-handler-overrides.mjs"
                                 "dist/proj-emscripten.js" "dist/proj-emscripten.wasm"
                                 "dist/proj.db" "dist/proj.ini"}]
                      (when-not (= want paths)
                        (println "The npm package files differ from the expected list.")
                        (println (str "  missing: " (sort (remove paths want))))
                        (println (str "  extra:   " (sort (remove want paths))))
                        (System/exit 1))
                      ;; An inlined copy of a package splits its module state
                      ;; from the copy that a consumer imports.
                      (doseq [f ["proj.mjs" "proj-handler.mjs" "proj-handler-overrides.mjs"]
                              :let [inlined (re-seq (re-pattern "(?m)^// node_modules/\\S+")
                                                    (slurp (str (fs/path dist-dir f))))]
                              :when (seq inlined)]
                        (println (str "dist/" f " inlines " (vec (distinct inlined))))
                        (System/exit 1)))
                    (println "Testing built npm package...")
                    (tasks/shell {:dir "test-npm-package"} "npm" "install")
                    (tasks/shell {:dir "test-npm-package"} "npm" "test"))}

  check:squint-pin
  {:doc "Make sure that the CDN importmaps of docs/index.html and the npm README use the squint-cljs version that package.json pins."
   :task (let [pin-re (re-pattern "\"squint-cljs\":\\s*\"\\^?([0-9][^\"]*)\"")
               map-re (re-pattern "squint-cljs@([0-9][^/\"]*)")
               pinned (second (re-find pin-re (slurp "src/cljc/net/willcohen/proj/package.json")))
               pages  ["docs/index.html" "src/cljc/net/willcohen/proj/README.md"]
               wrong  (for [page pages
                            v (map second (re-seq map-re (slurp page)))
                            :when (not= v pinned)]
                        [page v])]
           (when-not pinned
             (throw (ex-info "No squint-cljs version found in package.json" {})))
           (if (seq wrong)
             (do (binding [*out* *err*]
                   (println (str "squint-cljs is pinned at " pinned
                                 ", but the CDN importmaps use:"))
                   (doseq [[page v] wrong] (println (str "  " page " -> " v))))
                 (System/exit 1))
             (println (str "squint-cljs importmap pin matches package.json: " pinned))))}

  test:playwright {:doc "Run the browser integration tests with Playwright."
                   :depends [squint check:squint-pin]
                   :task (do
                           (stage-browser-resources!)
                           (println "Installing Playwright dependencies...")
                           (tasks/shell {:dir "test/browser"} "npm" "install")
                           (println "Installing Playwright browsers...")
                           ;; Only the browsers that playwright.config.js declares.
                           ;; A bare `install` also fetches webkit and deletes
                           ;; builds that no registered installation references.
                           (tasks/shell {:dir "test/browser"} "npx" "playwright" "install" "--with-deps" "chromium" "firefox")
                           (println "Running Playwright tests...")
                           (tasks/shell {:dir "test/browser"} "npm" "test"))}

  test:linux {:doc "Run the JVM, Node and npm suites in Linux containers (--platform linux/amd64|linux/aarch64)."
              :task (do
                      (println "Running tests on Linux platforms via Docker/Podman...")
                      (let [container-cmd (or (fs/which "podman") (fs/which "docker"))]
                        (if-not container-cmd
                          (println "Neither podman nor docker found, skipping Linux tests.")
                          (do
                            (println "--> Using" (str container-cmd) "for Linux platform tests.")
                            (let [opts (cli/parse-opts *command-line-args*
                                                       {:spec {:platform {:coerce :string}}})
                                  platforms (if-let [p (:platform opts)]
                                              [p]
                                              ["linux/amd64" "linux/aarch64"])
                                  docker-image "clojure:tools-deps-trixie"]
                              (doseq [platform platforms]
                                (let [arch (last (str/split platform (re-pattern "/")))
                                      platform-key (str/replace platform "/" "-")]
                                  (println (str "\n==> Testing on " platform))
                                  (let [native-lib-path (str "resources/" platform-key "/libproj.so")]
                                    (when-not (fs/exists? native-lib-path)
                                      (println (str "Warning: Native library not found at " native-lib-path))))
                                  (try
                                    ;; TODO: install babashka in a temp dir, not the mounted project directory.
                                    (tasks/shell container-cmd "run" "--rm" "--platform" platform
                                                 "-v" (str (fs/cwd) ":/work") "-w" "/work"
                                                 "--env" "CI=true"
                                                 docker-image
                                                 "bash" "-c"
                                                 (str "set -ex; "
                                                      "echo 'Testing clj-proj on " platform " with bundled libraries...'; "
                                                      "echo 'Installing babashka...'; "
                                                      "apt-get update && apt-get install -y curl nodejs npm; "
                                                      "curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install; "
                                                      "chmod +x install && ./install; "
                                                      "export PATH=$PATH:/usr/local/bin; "
                                                      "bb --version; "
                                                      "node --version; "
                                                      "echo 'Available bundled libraries:'; "
                                                      "ls -la resources/" platform-key "/ || echo 'No platform-specific libraries found'; "
                                                      "echo 'Running Clojure tests via babashka...'; "
                                                      "bb test:ffi; "
                                                      "bb test:graal; "
                                                      "echo 'Running Node.js tests...'; "
                                                      "bb test:node; "
                                                      "echo 'Running npm package tests...'; "
                                                      "bb test:npm"))
                                    (println (str "Tests passed on " platform))
                                    (catch Exception e
                                      (println (str "Tests failed on " platform ": " (.getMessage e)))
                                      (throw e))))))
                            (println "\nAll Linux platform tests completed successfully!")))))}

  test:jar {:doc "Run the downstream-dependency tests against the built JAR."
            :depends [jar]
            :task (let [jar-path (jar-file)
                        run-from-jar!
                        (fn [label extra-flags form]
                          (let [result (apply clojure.java.shell/sh
                                              clj-cmd "-J--enable-native-access=ALL-UNNAMED"
                                              (concat extra-flags
                                                      ["-Sdeps" (pr-str {:deps {'net.willcohen/proj {:local/root jar-path}}})
                                                       "-M" "-e" (pr-str form)]))]
                            (when (not= 0 (:exit result))
                              (println (str label " failed!"))
                              (print (:out result))
                              (print (:err result))
                              (System/exit 1))))]
                    (println "Testing JAR as downstream dependency...")
                    (println)

                    (println "0. Checking the clj-kondo exports and the notices in the JAR...")
                    (let [entries (set (str/split-lines
                                        (:out (tasks/shell {:out :string} "jar" "tf" jar-path))))]
                      (doseq [e ["clj-kondo.exports/net.willcohen/proj/config.edn"
                                 "clj-kondo.exports/net.willcohen/proj/hooks/proj.clj"
                                 "clj-kondo.exports/net.willcohen/proj/hooks/fn_defs.clj"
                                 "META-INF/LICENSE"
                                 "META-INF/THIRD-PARTY-NOTICES.md"]]
                        (when-not (contains? entries e)
                          (println (str "The JAR does not contain " e))
                          (System/exit 1)))
                      (println "   OK clj-kondo exports and notices"))

                    (println)
                    (println "1. Testing FFI mode from JAR...")
                    (run-from-jar!
                     "FFI test" []
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/force-ffi!)
                        (proj/init!)
                        (assert (proj/ffi?) "Should be in FFI mode")
                        (let [ctx (proj/context-create)]
                          (assert ctx "Context creation failed")
                          (let [t (proj/proj-create-crs-to-crs
                                   {:context ctx
                                    :source_crs "EPSG:4326"
                                    :target_crs "EPSG:3857"})]
                            (assert t "Transformer creation failed")))
                        (println "   OK FFI mode test passed")))

                    (println)
                    (println "2. Testing GraalVM/WASM mode from JAR...")
                    (run-from-jar!
                     "GraalVM test" ["-J-Dpolyglot.engine.WarnInterpreterOnly=false"]
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/force-graal!)
                        (proj/init!)
                        (assert (proj/graal?) "Should be in GraalVM mode")
                        (let [ctx (proj/context-create)]
                          (assert ctx "Context creation failed")
                          (let [t (proj/proj-create-crs-to-crs
                                   {:context ctx
                                    :source_crs "EPSG:4326"
                                    :target_crs "EPSG:3857"})]
                            (assert t "Transformer creation failed")))
                        (println "   OK GraalVM mode test passed")))

                    (println)
                    (println "3. Testing coordinate transformation from JAR...")
                    (run-from-jar!
                     "Transformation test" []
                     '(do
                        (require '[net.willcohen.proj.proj :as proj])
                        (proj/init!)
                        (let [ctx (proj/context-create)
                              t (proj/proj-create-crs-to-crs
                                 {:context ctx
                                  :source_crs "EPSG:4326"
                                  :target_crs "EPSG:3857"})
                              coord-array (proj/coord-array 1)
                              _ (proj/set-coords! coord-array [[-74.006 40.7128 0 0]])
                              _ (proj/proj-trans-array
                                 {:p t
                                  :direction 1
                                  :n 1
                                  :coord coord-array})
                              x (get-in coord-array [0 0])
                              y (get-in coord-array [0 1])]
                          (assert (< 4500000 x 4600000) "X coordinate out of range")
                          (assert (< y -12500000) "Y coordinate out of range")
                          (println (format "   OK Transformed NYC: [%.2f, %.2f]" x y)))))

                    (println)
                    (println "4. Testing Java API from JAR...")
                    (let [test-dir "target/java-jar-test"
                          clj-cp (clj-classpath)]
                      (fs/create-dirs test-dir)
                      (spit (str test-dir "/JavaJarTest.java")
                            "import net.willcohen.proj.PROJ;

public class JavaJarTest {
    public static void main(String[] args) {
        try {
            PROJ.init();
            Object ctx = PROJ.contextCreate();
            if (ctx == null) throw new RuntimeException(\"Context creation failed\");
            Object transform = PROJ.createCrsToCrs(ctx, \"EPSG:4326\", \"EPSG:3857\");
            if (transform == null) throw new RuntimeException(\"Transform creation failed\");
            System.out.println(\"   OK Java API test passed\");
        } catch (Exception e) {
            System.err.println(\"Java API test failed: \" + e.getMessage());
            e.printStackTrace();
            System.exit(1);
        }
    }
}
")
                      (let [compile-result (clojure.java.shell/sh
                                            "javac" "--release" "25"
                                            "-cp" (str jar-path path-sep clj-cp)
                                            "-d" test-dir
                                            (str test-dir "/JavaJarTest.java"))]
                        (when (not= 0 (:exit compile-result))
                          (println "Java compilation failed!")
                          (print (:out compile-result))
                          (print (:err compile-result))
                          (System/exit 1)))
                      (let [run-result (clojure.java.shell/sh
                                        "java"
                                        "-XX:+UnlockExperimentalVMOptions"
                                        "-XX:+EnableJVMCI"
                                        "--enable-native-access=ALL-UNNAMED"
                                        "-Dpolyglot.engine.WarnInterpreterOnly=false"
                                        "-cp" (str test-dir path-sep jar-path path-sep clj-cp)
                                        "JavaJarTest")]
                        (print (:out run-result))
                        (when (not= 0 (:exit run-result))
                          (println "Java run failed!")
                          (print (:err run-result))
                          (System/exit 1))))

                    (println)
                    (println "All JAR tests passed!"))}

  build
  {:doc "Build native, wasm, or cross-compiled artifacts. See `bb build --help`."
   :spec {:native {:alias :n, :desc "Build native artifacts for the host platform."}
          :wasm {:alias :w, :desc "Build the single-threaded WASM (used by Node, browser, and GraalVM)."}
          :wasm-browser {:desc "Alias for --wasm. There is only the single-threaded build."}
          :wasm-graal {:desc "Alias for --wasm. There is only the single-threaded build."}
          :cross {:desc "Build cross-compiled artifacts for default platforms."}
          :cross-platform {:desc "Build for a specific cross-platform target (for example linux/amd64)."
                           :coerce :string}
          :debug {:desc "WASM: -O0 -g, AddressSanitizer, ASSERTIONS=2, approximately 5x slower. Native: a Debug PROJ. Do not ship either."}
          :local-proj {:desc "Use local PROJ (default vendor/PROJ, or give a path)."}
          :target {:desc "The zig target of a --native build (for example linux-amd64-musl)."
                   :coerce :string}
          :help {:alias :h :desc "Show this help message."}}
   :task (let [opts (task-opts :native :wasm :wasm-browser :wasm-graal
                               :cross :cross-platform :debug :local-proj :target :help)]

           (let [target-dir "target"
                 proj-dir (if-let [local-proj-opt (:local-proj opts)]
                            (let [local-proj (if (or (= local-proj-opt true) (= local-proj-opt "true"))
                                               (fs/path "vendor" "PROJ")
                                               (fs/expand-home (str local-proj-opt)))
                                  target-proj-path (fs/path target-dir "PROJ-local")]
                              (when-not (fs/exists? local-proj)
                                (throw (ex-info "Local PROJ not found. Run 'bb proj:clone' first."
                                                {:local-proj-path (str local-proj)})))
                              (println (str "Using local PROJ from " local-proj))
                              (when (fs/exists? target-proj-path)
                                (println (str "Removing existing " target-proj-path))
                                (fs/delete-tree target-proj-path))
                              (println (str "Copying local PROJ to " target-proj-path "..."))
                              ;; rsync creates only the last dir of its destination.
                              (fs/create-dirs target-dir)
                              (if (fs/which "rsync")
                                (tasks/shell "rsync" "-av" "--exclude=.git"
                                             (str local-proj "/") (str target-proj-path "/"))
                                (fs/copy-tree local-proj target-proj-path {:replace-existing true}))
                              "PROJ-local")
                            (str "PROJ-" proj-version))]

             (let [{native? :native, debug? :debug, target-str :target} opts
                   wasm? (some opts [:wasm :wasm-browser :wasm-graal])
                   {host-os :os host-arch :arch} (nb/detect-host-platform)

                   build-sqlite (fn [{:keys [type install-dir cc zig-env host-flag is-linux? is-windows? debug?]}]
                                  (let [lib-path (fs/path install-dir "lib" "libsqlite3.a")]
                                    (when debug? (println "DEBUG: Checking for existing" (name type) "SQLite library at:" (str lib-path)))
                                    (when-not (fs/exists? lib-path)
                                      (println "Building SQLite for" (name type) "...")
                                      (let [build-dir (fs/path target-dir sqlite-dir (str "sqlite-build-" (name type) (when (= type :wasm) "-st")))
                                            configure-args (cond-> []
                                                             host-flag (conj host-flag)
                                                             (= type :wasm) (conj "--disable-shared" "--disable-editline" "--disable-readline")
                                                             (and (= type :native) is-linux?) (conj "--disable-shared" "--enable-static")
                                                             is-windows? (conj "--disable-shared" "--enable-static"))
                                            wasm-cflags (str "-DSQLITE_THREADSAFE=0 "
                                                             ;; No -fsanitize=address here. ASan adds shadow locals for
                                                             ;; each C local, and sqlite3VdbeExec then exceeds wasm's
                                                             ;; per-function local limit ("local count too large" at
                                                             ;; instantiation). The link-level ASan runtime still
                                                             ;; intercepts malloc/free, so heap corruption from PROJ
                                                             ;; that crashes in sqlite's allocator stays visible.
                                                             (if debug? "-O0 -g -gsource-map " "-O2 ")
                                                             "-s ERROR_ON_UNDEFINED_SYMBOLS=0 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DISABLE_LFS -DSQLITE_LONGDOUBLE_TYPE=double -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_NORMALIZE")
                                            env (cond-> (merge {"CC" cc} zig-env)
                                                  (and (= type :native) is-linux?) (assoc "CFLAGS" "-O2 -fPIC")
                                                  (= type :wasm) (assoc "CFLAGS" wasm-cflags))]
                                        (nb/build-autotools-library
                                         {:type type
                                          :build-dir build-dir
                                          :install-dir install-dir
                                          :configure-args configure-args
                                          :env env})))))

                   build-zlib (fn [{:keys [type install-dir cc zig-env host debug?]}]
                                (let [lib-path (fs/path install-dir "lib" "libz.a")]
                                  (when debug? (println "DEBUG: Checking for existing" (name type) "zlib library at:" (str lib-path)))
                                  (when-not (fs/exists? lib-path)
                                    (println "Building zlib for" (name type) "...")
                                    (let [src-dir (fs/path target-dir zlib-dir)
                                          env (cond-> (merge {"CC" cc} zig-env)
                                                ;; CHOST keeps configure from reading uname on a
                                                ;; macOS host, and --static needs -fPIC for libproj.so.
                                                zig-env (assoc "CHOST" host "CFLAGS" "-O2 -fPIC")
                                                (= type :wasm) (assoc "AR" "emar" "RANLIB" "emranlib")
                                                (and (= type :wasm) debug?)
                                                (update "CFLAGS" (fn [v] (str (or v "") " -O0 -g -gsource-map -fsanitize=address"))))
                                          patch-wasm-makefile
                                          (fn []
                                            ;; zlib's configure ignores AR and RANLIB on WASM and uses
                                            ;; libtool. Patch the Makefile to use emar.
                                            (let [makefile-path (str (fs/path src-dir "Makefile"))
                                                  content (slurp makefile-path)
                                                  patched (-> content
                                                              (str/replace (re-pattern "(?m)^AR=.*$") "AR=emar")
                                                              (str/replace (re-pattern "(?m)^ARFLAGS=.*$") "ARFLAGS=rcs")
                                                              (str/replace (re-pattern "(?m)^RANLIB=.*$") "RANLIB=emranlib")
                                                              (str/replace "/usr/bin/libtool -o" "emar rcs")
                                                              (str/replace "libtool -o" "emar rcs"))]
                                              (spit makefile-path patched)
                                              (println "Patched zlib Makefile to use emar for WASM")))]
                                      (nb/build-autotools-library
                                       {:type type
                                        :build-dir src-dir
                                        :install-dir install-dir
                                        :in-tree? true
                                        :configure-args ["--static"]
                                        :env env
                                        :post-configure (when (= type :wasm) patch-wasm-makefile)})))))

                   build-libtiff (fn [{:keys [type install-dir zlib-install-dir cc cxx zig-env host-flag is-darwin? is-linux? debug?]}]
                                   (let [lib-path (fs/path install-dir "lib" "libtiff.a")]
                                     (when debug? (println "DEBUG: Checking for existing" (name type) "LibTIFF library at:" (str lib-path)))
                                     (when-not (fs/exists? lib-path)
                                       (println "Building LibTIFF for" (name type) "...")
                                       (let [src-dir (fs/path target-dir libtiff-dir)
                                             configure-args (cond-> ["--disable-zstd"
                                                                     (str "--with-zlib-include-dir=" (fs/path zlib-install-dir "include"))
                                                                     (str "--with-zlib-lib-dir=" (fs/path zlib-install-dir "lib"))]
                                                              host-flag (conj host-flag)
                                                              (= type :native) (conj "--disable-shared" "--enable-static")
                                                              zig-env (conj "--disable-cxx")
                                                              (= type :wasm) (conj "--disable-tools" "--disable-contrib" "--disable-tests" "--disable-docs" "--disable-ccitt"))
                                             env (cond-> (merge {"CC" cc "CXX" cxx} zig-env)
                                                   (and (= type :native) is-linux?) (assoc "CFLAGS" "-O2 -fPIC" "CXXFLAGS" "-O2 -fPIC")
                                                   (= type :wasm) (assoc "CPPFLAGS" "-DHAVE_FCNTL_H=1")
                                                   (and (= type :wasm) debug?) (assoc "CFLAGS" "-O0 -g -gsource-map -fsanitize=address"
                                                                                      "CXXFLAGS" "-O0 -g -gsource-map -fsanitize=address"))
                                             patch-wasm-makefile
                                             (fn []
                                               ;; mkg3states is a native-only tool. For WASM, patch
                                               ;; libtiff/Makefile to skip it and write a dummy tif_fax3sm.c.
                                               (println "Patching libtiff Makefile to skip mkg3states for WASM...")
                                               (let [makefile-path (str (fs/path src-dir "libtiff" "Makefile"))
                                                     content (slurp makefile-path)
                                                     patched (-> content
                                                                 (str/replace (re-pattern "noinst_PROGRAMS = mkg3states") "noinst_PROGRAMS =")
                                                                 (str/replace (re-pattern "mkg3states:") "# mkg3states:")
                                                                 (str/replace (re-pattern "mkg3states\\.o") "# mkg3states.o"))]
                                                 (spit makefile-path patched))
                                               (let [fax3sm-path (fs/path src-dir "libtiff" "tif_fax3sm.c")]
                                                 (when-not (fs/exists? fax3sm-path)
                                                   (println "Creating dummy tif_fax3sm.c...")
                                                   (spit (str fax3sm-path) "/* Dummy file for WASM build */"))))]
                                         (when (fs/exists? (fs/path src-dir "Makefile"))
                                           (try
                                             (tasks/shell {:dir src-dir} "make" "distclean")
                                             (catch Exception e
                                               (println "Warning: make distclean failed, continuing anyway:" (.getMessage e)))))
                                         (fs/delete-if-exists (fs/path src-dir "config.status"))
                                         (fs/delete-if-exists (fs/path src-dir "config.cache"))
                                         (fs/delete-if-exists (fs/path src-dir "Makefile"))
                                         (fs/delete-if-exists (fs/path src-dir "libtool"))
                                         (when is-darwin?
                                           (tasks/shell {:dir src-dir} "sed" "-i.bak" "s/glibtoolize/libtoolize/g" "autogen.sh"))
                                         (try (tasks/shell {:dir src-dir :extra-env env} "./autogen.sh")
                                              (catch Exception _
                                                (println "autogen.sh failed, patching and retrying...")
                                                (tasks/shell {:dir src-dir} "sed" "-i.bak" "s|https://git.savannah.gnu.org/cgit/config.git/plain/|https://raw.githubusercontent.com/cgitmirror/config/refs/heads/master/|g" "autogen.sh")
                                                (tasks/shell {:dir src-dir :extra-env env} "./autogen.sh")))
                                         (nb/build-autotools-library
                                          {:type type
                                           :build-dir src-dir
                                           :install-dir install-dir
                                           :in-tree? true
                                           :configure-args configure-args
                                           :env env
                                           :post-configure (when (= type :wasm) patch-wasm-makefile)})))))

                   build-proj (fn [{:keys [type library-dir final-proj-lib cc cxx zig is-darwin? is-linux? is-windows? sqlite-install-dir zlib-install-dir libtiff-install-dir debug?]}]
                                (let [wasm-suffix (if (= type :wasm) "-st" "")
                                      build-dir (fs/path target-dir proj-dir (str "proj-build-" (if (= type :native) library-dir (name type)) wasm-suffix))]
                                  (println "Building PROJ for" (name type) "...")

                                  ;; No -fwasm-exceptions: emscripten 6.0.9 links it, but the
                                  ;; GraalWasm and browser suites have not run with it.
                                  (let [base-cxx-flags "-ftemplate-depth=256"
                                        cmake-args (cond-> ["-DBUILD_APPS=OFF" "-DBUILD_PROJSYNC=OFF" "-DBUILD_CCT=OFF" "-DBUILD_GEOD=OFF" "-DBUILD_GIE=OFF" "-DBUILD_PROJINFO=OFF" "-DBUILD_TESTING=OFF"
                                                            (str "-DCMAKE_BUILD_TYPE=" (if debug? "Debug" "Release"))
                                                            "-DCMAKE_DISABLE_FIND_PACKAGE_nlohmann_json=ON"
                                                            "-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
                                                            (str "-DCMAKE_INSTALL_PREFIX=" build-dir)
                                                            (str "-DCMAKE_CXX_FLAGS=" base-cxx-flags)
                                                            (str "-DSQLite3_INCLUDE_DIR=" (fs/path sqlite-install-dir "include"))
                                                            (str "-DSQLite3_LIBRARY=" (fs/path sqlite-install-dir "lib" "libsqlite3.a"))
                                                            (str "-DTIFF_INCLUDE_DIR=" (fs/path libtiff-install-dir "include"))
                                                            (str "-DTIFF_LIBRARY=" (fs/path libtiff-install-dir "lib" "libtiff.a"))
                                                            (str "-DZLIB_INCLUDE_DIR=" (fs/path zlib-install-dir "include"))
                                                            (str "-DZLIB_LIBRARY=" (fs/path zlib-install-dir "lib" "libz.a"))]

                                                     ;; The lib ships from the build tree, and the build rpath
                                                     ;; of CMake names that dir.
                                                     is-darwin? (conj "-DCMAKE_SKIP_BUILD_RPATH=ON")

                                                     zig (into (:cmake-args zig))
                                                     (= type :native) (conj "-DENABLE_CURL=OFF"
                                                                            "-DENABLE_NETWORK=ON"
                                                                            "-DBUILD_SHARED_LIBS=ON"
                                                                            (str "-DCMAKE_CXX_STANDARD_LIBRARIES="
                                                                                 (fs/path zlib-install-dir "lib" "libz.a")))
                                                     (and (= type :native) is-linux?) (conj "-DCMAKE_FIND_LIBRARY_SUFFIXES=.a"
                                                                                            "-DCMAKE_SKIP_RPATH=ON")
                                                     ;; zig puts the debug info of libc++ into the lib: 55 MB, not 9.
                                                     (and zig (not debug?)) (conj "-DCMAKE_SHARED_LINKER_FLAGS=-s")
                                                     (= type :wasm) (conj "-DBUILD_SHARED_LIBS=OFF"
                                                                          "-DCMAKE_POLICY_DEFAULT_CMP0135=NEW"
                                                                          "-DEMBED_RESOURCE_FILES=OFF"
                                                                          "-DENABLE_CURL=OFF"
                                                                          "-DENABLE_EMSCRIPTEN_FETCH=OFF")
                                                     (and (= type :wasm) debug?) (conj "-DCMAKE_C_FLAGS=-fsanitize=address"
                                                                                       (str "-DCMAKE_CXX_FLAGS=" base-cxx-flags " -fsanitize=address")))]
                                    (let [cmake-env {"CXX" cxx "CC" cc}]
                                      (try
                                        (nb/build-cmake-library
                                         {:type type
                                          :src-dir (fs/absolutize (fs/path target-dir proj-dir))
                                          :build-dir build-dir
                                          :cmake-args cmake-args
                                          :env cmake-env})
                                        (catch Exception e
                                          (let [error-log (fs/path build-dir "CMakeFiles" "CMakeError.log")
                                                output-log (fs/path build-dir "CMakeFiles" "CMakeOutput.log")]
                                            (when (fs/exists? error-log)
                                              (println "=== CMake Error Log ===")
                                              (println (slurp (str error-log))))
                                            (when (fs/exists? output-log)
                                              (println "=== CMake Output Log (last 100 lines) ===")
                                              (let [lines (str/split-lines (slurp (str output-log)))]
                                                (println (str/join "\n" (take-last 100 lines)))))
                                            (throw e))))))
                                  (cond
                                    (= type :wasm)
                                    (let [_ (require 'net.willcohen.proj.fndefs)
                                          fndefs-map (deref (resolve 'net.willcohen.proj.fndefs/fndefs))

                                          proj-function-names (->> (keys fndefs-map)
                                                                   (map name)
                                                                   (map (fn [s] (str "_" (str/replace s "-" "_"))))
                                                                   sort)

                                          emscripten-functions ["UTF8ArrayToString"
                                                                "UTF8ToString"
                                                                "___get_exception_message"
                                                                "_emscripten_stack_get_base"
                                                                "_emscripten_stack_get_current"
                                                                "_emscripten_stack_get_end"
                                                                "_emscripten_stack_get_free"
                                                                "_emscripten_stack_init"
                                                                "_emscripten_stack_set_limits"
                                                                "_free"
                                                                "lengthBytesUTF8"
                                                                "_malloc"]

                                          all-functions (concat emscripten-functions proj-function-names)
                                          runtime-methods ["FS" "ENV" "HEAPF64" "HEAPU8" "err"
                                                           "ccall" "cwrap" "stackAlloc" "stackSave" "stackRestore"
                                                           "getValue" "setValue" "stringToNewUTF8" "stringToUTF8"
                                                           "UTF8ToString" "addFunction"]]
                                      (let [output-name (str "proj-emscripten" wasm-suffix ".js")]
                                        (println "Building WASM:" output-name)
                                        (nb/emcc-link
                                         {:build-dir build-dir
                                          :output-name output-name
                                          :objects ["lib/libproj.a"
                                                    (str (fs/path libtiff-install-dir "lib" "libtiff.a"))
                                                    (str (fs/path zlib-install-dir "lib" "libz.a"))
                                                    (str (fs/path sqlite-install-dir "lib" "libsqlite3.a"))]
                                          :optimization (if debug? "-O0" "-O2")
                                          ;; ASan's wasm stack walker reads the -gsource-map sidecar,
                                          ;; not the DWARF from -g, for named C++ frames. The
                                          ;; .wasm.map sidecar must sit next to the wasm in dist/, or
                                          ;; emscripten init hangs on its source-map runDependency.
                                          :extra-flags (cond-> ["-s" "ASSERTIONS=1"]
                                                         debug? (into ["-g"
                                                                       "-gsource-map"
                                                                       "-sASSERTIONS=2"
                                                                       "-sSTACK_OVERFLOW_CHECK=2"
                                                                       "-fsanitize=address"
                                                                       "-sINITIAL_MEMORY=268435456"]))
                                          :exported-functions all-functions
                                          :exported-runtime-methods runtime-methods
                                          :allow-memory-growth? (not debug?)
                                          :maximum-memory 2147483648
                                          :module-name "PROJModule"})))

                                    (= type :native)
                                    (let [lib-dir (fs/path build-dir (if is-windows? "bin" "lib"))
                                          source-path (or (first (if is-windows?
                                                                   (concat (fs/glob lib-dir "libproj*.dll")
                                                                           (fs/glob lib-dir "proj*.dll"))
                                                                   (fs/glob lib-dir (if is-darwin? "libproj*.dylib" "libproj*.{a,so}"))))
                                                          (throw (ex-info "No PROJ library in the build dir"
                                                                          {:lib-dir (str lib-dir)})))]
                                      (println "Copying native build artifacts...")
                                      (fs/create-dirs (fs/path "resources" library-dir))
                                      (when zig
                                        (if is-windows?
                                          (nb/check-windows-lib! library-dir source-path)
                                          (nb/check-linux-lib! library-dir source-path)))
                                      (when is-darwin?
                                        (nb/check-darwin-lib! source-path))
                                      (fs/copy source-path final-proj-lib {:replace-existing true})
                                      (fs/copy (fs/path build-dir "data" "proj.db") (fs/path "resources") {:replace-existing true})
                                      (fs/copy (fs/path build-dir "data" "proj.ini") (fs/path "resources") {:replace-existing true})))))]

               (when debug?
                 (println "DEBUG: Detected host-os:" host-os)
                 (println "DEBUG: Detected host-arch:" host-arch))

               (doseq [[archive url dir] (cond-> source-archives (:local-proj opts) butlast)]
                 (nb/download-archive url (fs/path target-dir archive))
                 (nb/extract-archive archive dir target-dir))

               (when native?
                 (let [[target-os-str target-arch-str] (if target-str (str/split target-str (re-pattern "-")) [nil nil])
                       target-os (when target-os-str (keyword target-os-str))
                       target-arch (when target-arch-str (keyword target-arch-str))
                       effective-os (or target-os host-os)
                       effective-arch (or target-arch host-arch)
                       is-windows? (= effective-os :windows)
                       is-darwin? (= effective-os :darwin)
                       is-linux? (= effective-os :linux)

                       ;; A Linux target keeps its -musl suffix: linux-amd64-musl.
                       library-dir (if (and is-linux? target-str)
                                     target-str
                                     (str (name effective-os) "-" (name effective-arch)))
                       zig (when (or is-linux? is-windows?)
                             (nb/zig-toolchain! library-dir (fs/absolutize (fs/path "target" (str "zig-" library-dir)))))
                       cc (get-in zig [:env "CC"] (or (System/getenv "CC") "clang"))
                       cxx (get-in zig [:env "CXX"] (or (System/getenv "CXX") "clang++"))
                       host-flag (when zig (str "--host=" (:host zig)))
                       sqlite-install-dir (fs/absolutize (fs/path "target" (str "sqlite-install-" library-dir)))
                       zlib-install-dir (fs/absolutize (fs/path "target" (str "zlib-install-" library-dir)))
                       libtiff-install-dir (fs/absolutize (fs/path "target" (str "libtiff-install-" library-dir)))]

                   (println "--> Starting native build for" (if target-str (str target-str " (cross-compile)") library-dir))

                   (let [final-proj-lib (fs/path "resources" library-dir
                                                 (cond is-windows? "libproj.dll"
                                                       is-darwin? "libproj.dylib"
                                                       is-linux? "libproj.so"
                                                       :else "libproj.a"))]
                     (if (fs/exists? final-proj-lib)
                       (println "Skipping build - PROJ library already exists at:" (str final-proj-lib))
                       (do
                         (build-sqlite {:type :native
                                        :install-dir sqlite-install-dir
                                        :cc cc
                                        :zig-env (:env zig)
                                        :host-flag host-flag
                                        :is-linux? is-linux?
                                        :is-windows? is-windows?
                                        :debug? debug?})

                         (build-zlib {:type :native
                                      :install-dir zlib-install-dir
                                      :cc cc
                                      :zig-env (:env zig)
                                      :host (:host zig)
                                      :debug? debug?})

                         (build-libtiff {:type :native
                                         :install-dir libtiff-install-dir
                                         :zlib-install-dir zlib-install-dir
                                         :cc cc
                                         :cxx cxx
                                         :zig-env (:env zig)
                                         :host-flag host-flag
                                         :is-darwin? is-darwin?
                                         :is-linux? is-linux?
                                         :debug? debug?})

                         (build-proj {:type :native
                                      :library-dir library-dir
                                      :cc cc
                                      :cxx cxx
                                      :zig zig
                                      :final-proj-lib final-proj-lib
                                      :is-linux? is-linux?
                                      :is-darwin? is-darwin?
                                      :is-windows? is-windows?
                                      :sqlite-install-dir sqlite-install-dir
                                      :zlib-install-dir zlib-install-dir
                                      :libtiff-install-dir libtiff-install-dir
                                      :debug? debug?}))))))

               (when wasm?
                 (let [sqlite-install-dir-wasm-st (fs/absolutize (fs/path target-dir "sqlite-install-wasm-st"))
                       zlib-install-dir-wasm-st (fs/absolutize (fs/path target-dir "zlib-install-wasm-st"))
                       libtiff-install-dir-wasm-st (fs/absolutize (fs/path target-dir "libtiff-install-wasm-st"))
                       dest-resources "resources"
                       dest-resources-wasm (fs/path dest-resources "wasm")
                       dest-js-src "src/cljc/net/willcohen/proj"
                       proj-build-dir-wasm-st (fs/path target-dir proj-dir "proj-build-wasm-st")]

                   (println "--> Starting WASM build...")
                   (fs/create-dirs dest-resources-wasm)
                   (fs/create-dirs dest-js-src)

                   ;; One single-threaded build serves Node, the browser and GraalVM.
                   ;; pthreads hung `node --test` at worker teardown and forced COOP/COEP.
                   (if (fs/exists? (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js"))
                     (println "Reusing the existing single-threaded WASM build."
                              "Run `bb clean --wasm` first to pick up changed"
                              "build flags or C sources.")
                     (do
                       (println "Building single-threaded WASM dependencies...")
                       (build-sqlite {:type :wasm :install-dir sqlite-install-dir-wasm-st :cc "emcc" :debug? debug?})
                       (build-zlib {:type :wasm :install-dir zlib-install-dir-wasm-st :cc "emcc" :debug? debug?})
                       (build-libtiff {:type :wasm :install-dir libtiff-install-dir-wasm-st :zlib-install-dir zlib-install-dir-wasm-st
                                       :cc "emcc" :cxx "em++" :host-flag "--host=wasm32"
                                       :is-darwin? (= host-os :darwin) :debug? debug?})
                       (build-proj {:type :wasm :cc "emcc" :cxx "em++"
                                    :sqlite-install-dir sqlite-install-dir-wasm-st :zlib-install-dir zlib-install-dir-wasm-st
                                    :libtiff-install-dir libtiff-install-dir-wasm-st :debug? debug?})))

                   ;; The emcc build emits proj-emscripten-st.js, which names
                   ;; proj-emscripten-st.wasm internally. Consumers load the
                   ;; pair as proj-emscripten.{js,wasm}, and emscripten's Node
                   ;; loader obeys the internal name, so patch it before
                   ;; staging.
                   (when (fs/exists? (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js"))
                     (println "Deploying single-threaded WASM to src/cljc + resources/wasm...")
                     (let [wasm-src (fs/path proj-build-dir-wasm-st "proj-emscripten-st.wasm")
                           map-src  (fs/path proj-build-dir-wasm-st "proj-emscripten-st.wasm.map")
                           patched-js (str/replace (slurp (str (fs/path proj-build-dir-wasm-st "proj-emscripten-st.js")))
                                                   "proj-emscripten-st.wasm" "proj-emscripten.wasm")]
                       (doseq [dest [dest-js-src dest-resources-wasm]]
                         (spit (str (fs/path dest "proj-emscripten.js")) patched-js)
                         (fs/copy wasm-src (fs/path dest "proj-emscripten.wasm") {:replace-existing true})
                         (when (fs/exists? map-src)
                           (spit (str (fs/path dest "proj-emscripten.wasm.map"))
                                 (str/replace (slurp (str map-src)) "proj-emscripten-st.wasm" "proj-emscripten.wasm"))))
                       (fs/copy (fs/path proj-build-dir-wasm-st "data" "proj.db") dest-resources {:replace-existing true})
                       (fs/copy (fs/path proj-build-dir-wasm-st "data" "proj.ini") dest-resources {:replace-existing true})))

                   (when (fs/exists? (fs/path dest-js-src "proj-loader.mjs"))
                     (fs/copy (fs/path dest-js-src "proj-loader.mjs") dest-resources-wasm {:replace-existing true}))))

               (when (or (:cross opts) (:cross-platform opts))
                 (doseq [p (if-let [p (:cross-platform opts)] [p] cross-platforms)]
                   (apply tasks/shell "bb" "build" "--native" "--target" (str/replace p "/" "-")
                          (cond-> []
                            (:local-proj opts) (conj "--local-proj" (str (:local-proj opts)))
                            (:debug opts) (conj "--debug")))))
               (println "Build task finished."))))}

  gen-handler
  {:doc "Regenerate proj-handler.mjs from resources/proj-handler-classification.edn."
   :requires ([net.willcohen.native.gen-handler :as gh])
   :task (do
           (println "Regenerating proj-handler.mjs from classification.edn...")
           (let [classification (edn/read-string
                                 (slurp "resources/proj-handler-classification.edn"))
                 out-path "src/cljc/net/willcohen/proj/proj-handler.mjs"
                 ;; classification.edn carries :destroy-fns, so fndefs is empty.
                 fndefs {}]
             (gh/write-handler! fndefs classification out-path)
             (println (str "Wrote " out-path))))}

  squint {:doc "Compile the ClojureScript with squint-cljs and bundle with esbuild."
          :depends [gen-handler]
          :task (do
                  (println "Compiling ClojureScript with squint...")
                  (let [proj-dir "src/cljc/net/willcohen/proj"
                        files ["fndefs.cljc" "macros.cljc" "wasm.cljc" "proj.cljc" "handler.cljc"]]

                    ;; Overwrite dist/ in place. A wipe leaves a window in which a
                    ;; concurrent import of dist/proj.mjs fails.
                    (fs/create-dirs (fs/path proj-dir "dist"))

                    (println "Installing npm dependencies...")
                    (tasks/shell {:dir proj-dir} "npm" "install")

                    (nb/ensure-consumer-squint-edn! proj-dir)

                    (doseq [file files]
                      (println (str "Compiling " file "..."))
                      (nb/squint-compile! proj-dir file))

                    ;; squint emits the squint.edn :paths location of a required
                    ;; ns, which esbuild then inlines. The bare name stays
                    ;; external, so proj.mjs shares the consumer's ffi-wasm.
                    (nb/rewrite-import-specifiers!
                     (fs/path proj-dir "macros.mjs")
                     {"./node_modules/ffi-wasm/src/cljc/net/willcohen/native/macros.mjs" "ffi-wasm"})

                    (println "Squint compilation complete.")

                    (println "Running esbuild to bundle modules...")
                    (tasks/shell {:dir proj-dir} "npm" "run" "build")

                    (println "Copying WASM resources to dist...")
                    (let [dist-dir (fs/path proj-dir "dist")]
                      (fs/copy (fs/path "resources" "proj.db") (fs/path dist-dir "proj.db") {:replace-existing true})
                      (fs/copy (fs/path "resources" "proj.ini") (fs/path dist-dir "proj.ini") {:replace-existing true})
                      (fs/copy "THIRD-PARTY-NOTICES.md" (fs/path dist-dir "THIRD-PARTY-NOTICES.md") {:replace-existing true}))

                    (println "Bundle complete! Distribution in dist/")))}

  demo {:doc "Serve the browser demo at http://localhost:8080"
        :task (do
                (let [dist-dir (fs/path "src/cljc/net/willcohen/proj/dist")]
                  (when-not (and (fs/exists? (fs/path dist-dir "proj.mjs"))
                                 (fs/exists? (fs/path dist-dir "proj-handler.mjs")))
                    (println "Warning: dist folder missing files. Run 'bb squint' first.")))

                (let [link-path (fs/path "docs" "dist")
                      target-path (fs/path ".." "src" "cljc" "net" "willcohen" "proj" "dist")]
                  (when-not (fs/exists? link-path)
                    (println "Creating symlink docs/dist -> dist folder...")
                    (fs/create-sym-link link-path target-path)))

                (println "Starting demo server at http://localhost:8080")
                (println "Navigate to: http://localhost:8080/docs/")
                (println "Press Ctrl+C to stop")
                (tasks/shell "python3" "-m" "http.server" "8080"))}

  pom
  {:doc "Write target/classes/META-INF/maven/net.willcohen/proj/pom.xml."
   :task (do
           (println "Generating pom.xml...")
           (tasks/shell clj-cmd "-T:build" "pom")
           (println "pom.xml updated"))}

  jar
  {:doc "Build the project JAR."
   :task (do
           (println "Building JAR file...")
           (tasks/shell clj-cmd "-T:build" "jar")
           (babashka.fs/copy "target/classes/META-INF/maven/net.willcohen/proj/pom.xml" "pom.xml" {:replace-existing true})
           (println (str "JAR built: " (jar-file))))}

  clojars-deploy
  {:doc "Deploy the JAR to Clojars."
   :depends [jar]
   :task (let [artifact (jar-file)]
           (println (str "Deploying " artifact " to Clojars..."))
           (tasks/shell clj-cmd "-X:deploy" ":artifact" (pr-str artifact))
           (println "Deployed to Clojars"))}

  npm-publish
  {:doc "Publish the npm package."
   :depends [squint]
   :task (do
           (println "Publishing to npm...")
           (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "publish" "--tag" "alpha")
           (println "Published to npm"))}

  test:all
  {:doc "Run all test suites."
   :depends [test:ffi test:graal test:node test:playwright test:jar test:npm]}

  build:all
  {:doc "Build all artifacts (native, wasm, and cross-platform)."
   :task (do
           (println "Building native artifacts...")
           (tasks/shell "bb" "build" "--native")
           (println "Building WASM artifacts...")
           (tasks/shell "bb" "build" "--wasm")
           (println "Building cross-platform artifacts...")
           (tasks/shell "bb" "build" "--cross")
           (println "All builds complete!"))}

  test-run
  {:doc "Run all build and test tasks (except deploy)."
   :depends [clean pom build:all squint test:all jar]}

  quickdoc {:doc "Run quickdoc."
            :extra-deps {io.github.borkdude/quickdoc {:git/tag "v0.2.5", :git/sha "25784ca"}}
            :task (exec 'quickdoc.api/quickdoc)
            :exec-args {:git/branch "main"
                        :github/repo "https://github.com/willcohen/clj-proj"
                        :source-paths ["src/cljc/net/willcohen/proj/proj.cljc"]}}

  jar-contents {:doc "List all files in the JAR."
                :task (do
                        (println "\nJAR contents:")
                        (println "=============")
                        (tasks/shell "jar" "tf" (jar-file))
                        (println))}

  npm-contents {:doc "List the files that the npm package will contain."
                :task (do
                        (println "\nNPM package contents:")
                        (println "====================")
                        (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "pack" "--dry-run")
                        (println))}

  pre-deploy {:doc "Run all tests and show the package contents before deploy."
              :depends [test-run jar-contents npm-contents]
              :task (println "\nPre-deploy checks complete. Ready for deploy.")}

  deploy:dry-run
  {:doc "Show what deploy will do: version, git status, JAR contents, and npm dry-run."
   :depends [jar squint]
   :task (let [version (project-version)]
           (println (str "\n=== Deploy dry-run for " version " ===\n"))

           (println "npm auth:")
           (let [result (clojure.java.shell/sh "npm" "whoami")]
             (if (zero? (:exit result))
               (println (str "  Logged in as: " (str/trim (:out result))))
               (do (println "  NOT LOGGED IN. Run: npm login")
                   (System/exit 1))))
           (println)

           (println "Clojars auth:")
           (if (or (System/getenv "CLOJARS_USERNAME")
                   (.exists (java.io.File. (str (System/getProperty "user.home") "/.m2/settings.xml"))))
             (println "  Credentials found")
             (println "  WARNING: No CLOJARS_USERNAME env var or ~/.m2/settings.xml found"))
           (println)

           (println "Git status:")
           (tasks/shell "git" "status" "--short")
           (println)

           (println "Git log (last 3):")
           (tasks/shell {:extra-env {"GIT_PAGER" ""}} "git" "log" "--oneline" "-3")
           (println)

           (run 'jar-contents)
           (run 'npm-contents)

           (println "npm publish dry-run:")
           (tasks/shell {:dir "src/cljc/net/willcohen/proj"} "npm" "publish" "--dry-run" "--tag" "alpha")
           (println)

           (println (str "Ready to deploy " version ". Run: bb deploy")))}

  deploy {:doc "Tag, push, and deploy to Clojars and npm. Run after you commit the release changes."
          :task (let [version (project-version)
                      npm-pkg "proj-wasm"
                      tag version]
                  (println (str "Deploying " version "..."))
                  (println)

                  (let [status (:out (clojure.java.shell/sh "git" "status" "--porcelain"))]
                    (when (seq (str/trim status))
                      (println "ERROR: Uncommitted changes. Commit first.")
                      (System/exit 1)))

                  (println (str "Tagging " tag "..."))
                  (tasks/shell "git" "tag" tag)

                  (println "Pushing to origin...")
                  (tasks/shell "git" "push" "origin" "main" "--tags")

                  (println "Deploying to Clojars...")
                  (run 'clojars-deploy)

                  (println "Publishing to npm...")
                  (run 'npm-publish)

                  (println (str "Setting npm latest tag to " version "..."))
                  (tasks/shell "npm" "dist-tag" "add" (str npm-pkg "@" version) "latest")

                  (println)
                  (println (str "Deployed " version " to Clojars and npm.")))}

  version-bump {:doc "Bump the version in all files. Usage: bb version-bump <new-version>"
                :task (let [new-version (first *command-line-args*)]
                        (if (nil? new-version)
                          (do
                            (println "Usage: bb version-bump <new-version>")
                            (println "Example: bb version-bump 0.1.0-alpha5")
                            (System/exit 1))
                          (do
                            (println (str "Bumping version to " new-version "..."))
                            (println)
                            (let [build-content (slurp "build.clj")
                                  old-version (project-version)]
                              (when-not old-version
                                (println "Could not read the current version from build.clj.")
                                (System/exit 1))
                              (spit "build.clj"
                                    (str/replace build-content
                                                 (str "def version \"" old-version "\"")
                                                 (str "def version \"" new-version "\"")))
                              (println (str "  build.clj: " old-version " -> " new-version))
                              (doseq [[path old-text new-text]
                                      [["src/cljc/net/willcohen/proj/package.json"
                                        (str "\"version\": \"" old-version "\"")
                                        (str "\"version\": \"" new-version "\"")]]]
                                (let [content (slurp path)]
                                  (if (str/includes? content old-text)
                                    (do (spit path (str/replace content old-text new-text))
                                        (println (str "  " path ": " old-version " -> " new-version)))
                                    (println (str "  " path ": no " old-version " reference found, skipped"))))))
                            (println)
                            (println "Version bump complete.")
                            (println)
                            (println "Update CHANGELOG.md manually:")
                            (println "  1. Move [Unreleased] items to new version section")
                            (println "  2. Add date to version heading")
                            (println "  3. Add link reference at bottom of file")
                            (println)
                            (println "Update docs/index.html manually after the npm publish:")
                            (println "  1. Point the proj-wasm importmap pin at the new version")
                            (println "  2. Align the importmap with the bundle: squint-cljs entries")
                            (println "     (see test/browser/cdn-style/index.html), worker-router")
                            (println "     0.0.2+ (its blob shim permits a CDN worker-bootstrap),")
                            (println "     comlink, and the current resource-tracker")
                            (println "  3. Update the How-it-works build notes if the toolchain moved"))))}}}
