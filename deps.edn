{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        cnuernber/dtype-next {:mvn/version "11.025"}
        techascent/tech.resource {:mvn/version "5.09"}
        org.graalvm.js/js-language {:mvn/version "25.2.4"}
        org.graalvm.polyglot/polyglot {:mvn/version "25.2.4"}
        org.graalvm.wasm/wasm-language {:mvn/version "25.2.4"}
        ;; Optimizing (guest-JIT) Truffle runtime, which uses libgraal from a
        ;; GraalVM CE 25 JDK to JIT-compile the PROJ wasm guest. A stock
        ;; OpenJDK 25 cannot load libgraal cleanly (JDK-8364936), so run JVM
        ;; work on GraalVM CE.
        org.graalvm.truffle/truffle-runtime {:mvn/version "25.2.4"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        net.willcohen/native {:mvn/version "0.0.1"}}

 :aliases {;; Develop against a clj-native checkout: clojure -A:dev ...
           ;; The nix twin is --override-input clj-native path:/abs/path.
           :dev {:override-deps {net.willcohen/native {:local/root "../clj-native"}}}
           ;; -d is scoped to test/cljc/net because tools.namespace discovery
           ;; follows two symlink traps (test/js/node_modules/proj-js and
           ;; test/cljc/node_modules/proj-wasm) into a nested resource-tracker
           ;; test whose ns require cannot resolve. The other test/cljc roots
           ;; are cljs-only.
           :test {:extra-paths ["test/cljc"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                  :main-opts ["-m" "cognitect.test-runner" "-d" "test/cljc/net"]}
           :build {:deps {io.github.clojure/tools.build
                          {:git/tag "v0.10.9" :git/sha "e405aac"}}
                   :ns-default build}
           ;; `bb clojars-deploy` supplies :artifact, computed from the
           ;; version in build.clj.
           :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                    :exec-fn deps-deploy.deps-deploy/deploy
                    :exec-args {:installer :remote
                                :sign-releases? false}}}}
