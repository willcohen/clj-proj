;; Consumers call the generated public PROJ surface, whose fns are interned
;; at runtime. Without these hooks, each call site reads as "Unresolved var".
;;
;; The hooks require hooks.native.generated from net.willcohen/native, so a
;; consumer must copy that config too:
;;   clj-kondo --lint "$(clojure -Spath)" --copy-configs --skip-lint
{:hooks {:analyze-call {net.willcohen.proj.macros/define-all-proj-public-fns hooks.proj/define-all-proj-public-fns
                        macros/define-all-proj-public-fns hooks.proj/define-all-proj-public-fns}}}
